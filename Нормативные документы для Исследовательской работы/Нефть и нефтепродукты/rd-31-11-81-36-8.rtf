{\rtf1\ansi\ansicpg1251\deff0\deftab720{\fonttbl{\f0\fcharset204 Times New Roman;}{\f1\fcharset204 courier new;}}{\colortbl;\red0\green0\blue0;\red0\green0\blue255;}{\info{\author Softplicity}{\keywords }{\doccomm CoolUtils Engine2.5.1 (www.gnostice.com)}{\creatim\yr2011\mo11\dy22\hr10\min29}}\viewkind1\paperw11905\paperh16838\margl0\margr0\margt0\margb0\headery0\footery0 \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-1328\par}{\pard \sl-0\tx9900{\tab\f0\cf1\fs24 Утверждены}\par}{\pard \sl-233\par}{\pard \sl-0\tx7230{\tab\f0\cf1\fs24 Министерством морского флота СССР}\par}{\pard \sl-807\par}{\pard \sl-0\tx1350{\tab\f0\cf1\fs28 \b ПРАВИЛА МОРСКОЙ ПЕРЕВОЗКИ НЕФТИ И НЕФТЕПРОДУКТОВ}\par}{\pard \sl-0\tx3705{\tab\f0\cf1\fs28 \b НАЛИВОМ НА ТАНКЕРАХ ММФ}\par}{\pard \sl-0\tx4830{\tab\f0\cf1\fs28 \b РД 31.11.81.36-81}\par}{\pard \sl-829\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Настоящие Правила распространяются на перевозку нефти и нефтепродуктов на наливных судах}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 всех классов Министерства морского флота.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Правила перевозки нефти и нефтепродуктов на танкерах морского флота устанавливают}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требования безопасности при осуществлении грузовых операций, мойки и дегазации танков,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проведении ремонтных и других работ, связанных с эксплуатацией танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Правила устанавливают обязательные для морского флота и клиентуры условия морской}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перевозки нефти и нефтепродуктов наливом на морских судах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Все действующие инструкции и другие документы, касающиеся эксплуатации нефтеналивных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкеров, должны быть приведены в соответствие с настоящими Правилами.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4845{\tab\f0\cf1\fs24 \b 1. Общие положения}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.1. В настоящие Правила полностью вошли Правила обеспечения пожарной безопасности на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтеналивных судах морского флота СССР, утвержденные ММФ 19 февраля 1957 г. (Тарифное}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 руководство 4-М).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.2. Во всем, что специально не предусмотрено настоящими Правилами, следует}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 руководствоваться Уставом службы на судах Министерства морского флота Союза ССР, Правилами}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 техники безопасности на судах морского флота, Наставлением по предотвращению загрязнения с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судов, Наставлением по борьбе за живучесть судов Минморфлота Союза ССР РД 31.60.14-81,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Международной конвенцией по предотвращению загрязнения с судов 1973 г. "МАРПОЛ-73/78",}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Международной конвенцией по охране человеческой жизни на море 1974 г. "СОЛАС-74",}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Постановлением Совета Министров СССР от 14 февраля 1974 г. N 118 "Об усилении борьбы с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загрязнением моря веществами, вредными для здоровья людей и живых ресурсов моря", ГОСТами и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 другими действующими нормативными документами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.3. Суда, предназначенные для перевозки нефти и нефтепродуктов наливом, должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 удовлетворять Правилам классификации и постройки морских судов Регистра СССР или других}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 классификационных обществ, имеющих соответствующие соглашения с Регистром СССР, и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Правилам по предотвращению загрязнения моря с судов (конструкция и оборудование) Регистра}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 СССР 1979 г.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.4. При разработке настоящих Правил учтены Рекомендации Международного руководства по}\par}{\pard \sl-203\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасности на нефтяных танкерах и в нефтегаванях.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.5. Запрещается использование плавучих средств для выгрузки нефтепродуктов из танкера или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 для их налива, если они не имеют на это документов Регистра СССР или другого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 классификационного общества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.6. Суда, противопожарные устройства и оборудование которых не отвечают требованиям}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Правил противопожарной защиты судов Регистра СССР или имеют неисправность, впредь, до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 устранения не могут быть допущены к перевозке нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.7. Швартовка к танкеру, груженному легковоспламеняющимися нефтепродуктами или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 недегазированному, разрешается только тем судам и плавучим средствам (лихтерам, баржам,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 бункеровщикам и др.), противопожарная защита которых отвечает требованиям Регистра СССР или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 другого классификационного общества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.8. Экипажи судов и других плавучих средств (лихтеров, барж, бункеровщиков и др.), стоящих у}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борта танкера, должны соблюдать противопожарный режим, установленный для танкеров.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.9. В тех случаях, когда в порту нет места для швартовки к причалу, танкер обязан стать на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рейде по указанию портовых властей в стороне от обычного пути движения других судов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 1.10. При стоянке танкера в порту или на рейде, когда на борту имеется груз нефтепродуктов или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 когда танкер не дегазирован или производит мойку и дегазацию танков, он обязан нести на видном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 месте следующие сигналы:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 днем - флаг "Б" по Международному своду сигналов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 ночью - красный огонь, видимый по всему горизонту.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4815{\tab\f0\cf1\fs24 \b 2. Общие требования}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.1. На танкере на видных местах должны быть нанесены, а у трапа выставлены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предупредительные надписи: "Не курить", "Посторонним вход запрещен" на русском и английском}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 языках.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.2. Посещение танкеров посторонними лицами, не имеющими специального разрешения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пароходства или капитана, запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.3. Курение, использование спичек и зажигалок на танкере, когда на борту имеется груз}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов или производятся работы по мойке или дегазации танков, и на недегазированном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкере разрешается только в специально отведенных и оборудованных для этого в кормовой части}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна курительных помещениях.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Во время хода судна с разрешения капитана допускается также курение в штурманской,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 радиорубке, в кают-компании и в салоне капитана.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.4. Члены экипажа, занятые на грузовых операциях и работающие в районе грузовой палубы,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 не должны иметь при себе спички и зажигалки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.5. При стоянке танкера у причала, где перегружают нефть и нефтепродукты, курение может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть разрешено только в местах, установленных капитаном и согласованных с ответственным}\par}{\pard \sl-353\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 представителем берега. Эти места должны быть обозначены специальными надписями.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.6. Во время проведения грузовых операций, мойки и дегазации танков на борту танкера}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 запрещается пользоваться открытым огнем, проводить огневые работы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.7. Эксплуатация камбузного оборудования на стоянках должна производиться в соответствии}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 с действующими в данном порту правилами пожарной безопасности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.8. Запрещается пользоваться на камбузе открытым огнем во время проведения грузовых работ,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мойки и дегазации танков из-под нефти и нефтепродуктов, а также когда кормовая грузовая}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 магистраль используется для выкачки грязного балласта или моечной воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.9. Пищевые котлы и другое камбузное оборудование, подогреваемые паром, могут быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 использованы во всех случаях.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.10. Камбузные двери и иллюминаторы, открывающиеся на грузовую палубу или на палубы,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 примыкающие к грузовой, должны быть закрыты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.11. На судне запрещается накапливать просмоленную ветошь во избежание ее}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 самовоспламенения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.12. На танкере, если он не дегазирован, запрещается применять на грузовой палубе стальные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 швартовные канаты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.13. В целях предотвращения искрообразования синтетические швартовные канаты должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть обработаны в 2-процентном солевом растворе. В процессе эксплуатации синтетические канаты}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 следует периодически, не реже одного раза в 2 мес., окатывать на палубе забортной водой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.14. Во время стоянки у причала аварийные пожарные канаты для буксировки должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приспущены до воды с носа и кормы со стороны морского борта. Канаты должны быть стальными,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующей прочности, разноситься с запасом слабины около половины длины судна и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 надежно крепиться на кнехты. По мере выгрузки огоны канатов должны притравливаться, чтобы в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 случае необходимости буксировки судна подошедшие буксиры могли принять их самостоятельно.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.15. Искрогасители, установленные на выхлопных и дымовых трубах танкеров, а также}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обслуживающих танкеры буксировщиков и других плавучих средств, должны поддерживаться в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 исправном техническом состоянии.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.16. На танкерах искрогашение включается перед грузовыми операциями. На других судах,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обслуживающих танкеры, искрогашение должно быть включено на все время стоянки у борта}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкера. Вахтенные должны вести наблюдение за дымовыми трубами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.17. При появлении искр или загорании сажи в трубах на танкере или судне, обслуживающем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкер, грузовые операции немедленно прекращаются, все крышки, лючки танков закрываются и на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судне объявляется общесудовая тревога.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.18. Чтобы исключить возможность возникновения искрообразования и пожаров в дымовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубах, выхлопные глушители и искрогасители должны содержаться чистыми и в рабочем состоянии.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.19. До подхода танкера к порту дымовые и выхлопные трубы необходимо продуть паром или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воздухом во избежание загорания сажи в период проведения грузовых операций. О продувании труб}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должна быть сделана соответствующая запись в машинном журнале. Продувание труб на акватории}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 порта запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.20. На грузовой палубе танкера во время производства грузовых операций, мойки и дегазации}\par}{\pard \sl-323\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков, а также при плавании с грузом запрещается производить судовые работы с применением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ударного инструмента во избежание искрообразования. Такие работы могут выполняться в случае,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 когда танкер дегазирован.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.21. Запрещается оставлять инструменты на площадках у приемных клинкетов, переходном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мостике, а также на решетках и трапах насосных отделений и танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.22. На танкере запрещается пользоваться инструментом и приспособлениями,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изготовленными из алюминиево-магниевых сплавов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.23. Все дельные вещи на грузовой палубе - такелажные скобы и звенья должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прихвачены электросваркой или оклетневаны во избежание искрообразования в случаях их ударов о}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 металлические части судна. Все откидные крышки, люки, болты закрытий должны быть снабжены в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 местах возможных ударов прокладками из материала, не образующего искры.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.24. Замерные ручные устройства (футштоки), пробоотборники, гири рулеток и т.п. должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть выполнены из материала, исключающего опасное искрообразование при ударах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.25. На недегазированном танкере в районе грузовой палубы, в насосных отделениях,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 коффердамах, аккумуляторных запрещается пользоваться переносными лампами и инструментом с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электрокабелем, а также размещать какие-либо переносные электрические приборы и установки.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Установка телефонного аппарата взрывозащищенного исполнения на период стоянки в порту}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разрешается в районе судового трапа или в другом, по усмотрению капитана, месте.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.26. На танкерах допускается использование индивидуальных электрофонарей только}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывобезопасного типа, одобренного Регистром СССР. Запрещается пользоваться неисправными}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электрофонарями.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.27. В каютах запрещается устраивать временные электропроводки, использовать самодельные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электроприборы и затемнители, снимать со штатных мест настольные лампы, электровентиляторы и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 другое оборудование.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.28. Использование и хранение в жилых помещениях танкера переносных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электронагревательных приборов запрещается. Пользоваться электроутюгами, а также}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электроприборами личного пользования допускается только в специально отведенном и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 оборудованном для этой цели помещении. При уходе из каюты необходимо выключить освещение.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.29. На дверях аккумуляторных помещений должен быть нанесен знак "Осторожно! Опасность}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрыва!".}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.30. Кислота и щелочь должны храниться раздельно в отдельных помещениях, в плотно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закупоренных бутылях, помещенных в плетеные корзины, снабженные ручками для подъема.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Корзины должны быть плотно принайтовлены.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.31. Хранение бензина, керосина, лаков и других горючих жидкостей в жилых каютах и других}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помещениях, кроме специально для этого отведенных, запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.32. Матрацы, подушки, мягкая мебель, занавески, ковры и другие предметы оборудования}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 жилых кают и общественных помещений должны пропитываться огнестойкими составами. Для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предметов мягкого инвентаря не должны применяться синтетические материалы, способные к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электризации.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.33. При необходимости приема предметов и материалов судового снабжения на грузовую}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 палубу и их перемещения грузовые операции на это время должны быть прекращены.}\par}{\pard \sl-443\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.34. Запчасти и снабжение в металлической таре принимают и перемещают в места их}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 хранения или использования по специально выложенному брезенту, дорожке или деревянному}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 настилу.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.35. Для промывки и чистки машин и деталей механизмов запрещается применять в машинном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отделении бензин, керосин и другие легковоспламеняющиеся и горючие жидкости. Необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 руководствоваться РД 31.28.51-78 "Инструкция по очистке электрических машин в судовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 условиях".}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.36. При наличии сварочной мастерской на танкере и документов Регистра СССР на ее}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 эксплуатацию сварочные работы в мастерской могут проводиться только при получении ежегодного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 специального разрешения органов пожарного надзора ВОХР.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.37. В сварочной мастерской должна быть вывешена инструкция, определяющая организацию}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасного выполнения сварочных работ на судне. Инструкция должна быть составлена с учетом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требований НБЖС (РД 31.60.14-81).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.38. Включение электросварочного оборудования должно выполняться электромехаником.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Сварочные электрокабели, предназначенные для выполнения работ вне сварочной мастерской,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо хранить в закрытой кладовой и выдавать только при наличии письменного разрешения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 капитана на производство сварочных работ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.39. В исключительных случаях, связанных с устранением последствий аварии и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 невозможностью произвести дегазацию судна или его емкостей, по специальному указанию}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пароходства может быть рассмотрен вопрос о производстве газосварочных работ с принятием}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 надежных мер предосторожности, которые полностью исключили бы возможность загорания или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрыва на судне.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В этом случае должна быть обеспечена надежная инертизация загазованных емкостей с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помощью инертных газов, или эти емкости, на которых будут производиться огневые работы, и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 смежные с ними должны быть заполнены водой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Места производства указанных работ и меры безопасности должны быть определены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 комиссией под председательством капитана танкера, в которую должны быть включены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 специалисты пароходства, судоремонтного предприятия, инспектор Регистра СССР, ВОХР, старший}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 механик и старший помощник капитана танкера, и оформлены соответствующим актом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.40. Закрытия световых люков машинного и котельного отделений со стороны палубы всегда}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны находиться в рабочем состоянии для быстрого закрытия во время возникновения пожара.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.41. Двери машинно-котельного отделения, выходящие на открытую палубу, должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрыты во время проведения грузовых операций, мойки и дегазации грузовых танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.42. В связи с большим количеством жидкого топлива в машинно-котельном отделении и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прилегающих к нему отсеках требуется постоянное выполнение следующих профилактических мер:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.42.1. При открытии бункерных цистерн или разборке топливных трубопроводов запрещается}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пользоваться открытым огнем, входить в отсеки с переносными электролампами взрывоопасного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 типа и применять временную электропроводку. Для освещения разрешается использовать только}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 фонари взрывобезопасного исполнения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.42.2. Все горловины и трубопроводы цистерн жидкого топлива должны быть всегда закрыты}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и не иметь течи.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Во избежание разлива нефтепродуктов при выемке фильтров, при открывании пробных кранов}\par}{\pard \sl-143\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 насосов и разборке форсунок необходимо подставлять поддоны.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.42.3. Хранить чистую ветошь и обтирку следует в безопасных от огня местах, где они не могут}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подвергаться действию воды и масла.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Хранить эти материалы в румпельном отделении, в сухогрузном трюме, соприкасающемся с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 носовым коффердамом, запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.42.4. В котельных отделениях во избежание опасности возникновения взрыва и пожара}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 не допускать течи в системе топливопроводов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 строго следить за качеством обмуровки котлов, особенно пода;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 перед зажиганием форсунки хорошо провентилировать топку в целях удаления взрывоопасной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 смеси газов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 не допускать скопления нефтепродуктов в поддонах котлов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.43. Во всех станциях пожаротушения на видных местах должна быть вывешена инструкция о}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 правилах пуска станции в действие.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.44. На суда со склада должен выдаваться пенообразователь, на который имеется заключение}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 лаборатории о его годности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.45. Зарядка пенообразователем судовой станции пенотушения производится членами экипажа}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 под руководством второго механика.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.46. Проверка качества находящихся на судне пеногенераторного порошка и жидких}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пенообразователей должна производиться не реже одного раза в полугодие в лаборатории.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.47. Станция углекислотного тушения должна быть снабжена устройством для взвешивания}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 баллонов или замера уровня жидкости в них. Взвешивание баллонов или замер уровня углекислоты в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 них необходимо проводить один раз в год.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.48. Пенные огнетушители судового инвентаря должны подвергаться гидравлическому}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 испытанию корпуса на прочность один раз в год.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.49. Углекислотные огнетушители необходимо один раз в год взвешивать для проверки утечки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 углекислоты. При уменьшении массы заряда на 10% и более огнетушитель следует подзарядить или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перезарядить на специальной зарядной станции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.50. Зарядка огнегасительной жидкостью системы СЖБ производится силами судового}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 экипажа под непосредственным контролем старшего механика и представителя пожарно-}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 технической службы ВОХР.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51. Свидетельство пожарной охраны для выхода танкера в море не выдается, если:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.1. Хотя бы одна из систем пожаротушения неисправна, не готова к немедленному}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 использованию или экипаж не имеет навыка по эксплуатации систем.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.2. Дыхательные противодымные изолирующие противогазы отсутствуют или находятся в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 неисправном состоянии, или экипаж не обучен правилам пользования ими, или не произведена}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверка аппаратов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.3. Судовая система пожарной сигнализации неисправна.}\par}{\pard \sl-83\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-938\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.4. Переливные цистерны жидкого топлива заполнены бункером или другой жидкостью.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.5. Отсеки судна, защищаемые системой объемного пожаротушения, не имеют}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приспособлений для закрытия помещений извне.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.6. Противопожарные переборки имеют неисправную огнезащитную изоляцию.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Противопожарные двери, противопожарные заслонки воздуховодов и их автоматическое или ручное}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрытие неисправны.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.7. Противопожарное снабжение судна не соответствует установленным нормам Регистра}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 СССР.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.8. Имеются другие нарушения настоящих Правил.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.51.9. Не устранены дефекты противопожарного состояния судна, выявленные при его осмотре}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в последнем порту захода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.52. Порядок передачи сообщений о разливах нефти, смесей или других веществ, вредных для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 здоровья людей или для живых ресурсов моря, в пределах внутренних морских и территориальных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вод СССР определяется Инструкцией о порядке передачи сообщений капитанами морских судов и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 других плавучих средств и командирами воздушных судов о всех случаях нарушения Правил}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предотвращения загрязнения моря, введенной в соответствии с Постановлением Совета Министров}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 СССР N 118 от 14 февраля 1974 г.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.53. Сообщение о происшедшем разливе нефти или смесей с борта танкера необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 адресовать в пароходство и администрации ближайшего порта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При обнаружении разлива нефти с другого судна сообщение необходимо адресовать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 администрации ближайшего порта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 2.54. Сообщение о происшедшем разливе нефти или других вредных веществ должно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 передаваться без задержки и включать в себя следующие данные:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 тип, название, флаг судна, с которого поступает сообщение;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 местонахождение разлива;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 название судна, с которого произошел разлив;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 гидрометеорологические условия на месте инцидента (видимость, сила и направление ветра,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 температура морской воды, состояние моря);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 характер загрязнения (сплошное поле, полосы, пятна);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 состояние загрязнителя (твердое, жидкое, газообразное);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 величину загрязненной площади;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 толщину слоя загрязнителя;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вид загрязнителя в соответствии с классификацией Международного морского кодекса опасных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузов ИМО.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Каждое сообщение дополняется при необходимости любыми другими сведениями,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 относящимися к происшедшему разливу.}\par}{\pard \sl-488\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-1328\par}{\pard \sl-0\tx3225{\tab\f0\cf1\fs24 \b 3. Требования к грузовому оборудованию танкера,}\par}{\pard \sl-308\par}{\pard \sl-0\tx3675{\tab\f0\cf1\fs24 \b относящиеся к предотвращению разливов}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.1. Грузовое оборудование танкера должно обеспечивать безопасное проведение грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операций и не допускать загрязнения моря нефтяными грузами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.2. Если грузовой насос танкера может создать в трубопроводе давление, превышающее}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 допустимое рабочее давление, и на насосе отсутствует перепускной предохранительный клапан, то}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 такой клапан должен быть установлен на напорном трубопроводе танкера, чтобы во время выгрузки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 максимальное давление в трубопроводе не превышало рабочее даже при закрытии клинкета на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 берегу, что предотвратит разрыв грузового шланга или поломку стендера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Предохранительный клапан должен открываться при давлении на 10% выше рабочего.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.3. Грузовые стрелы танкера должны обеспечивать безопасный подъем шлангов, включая}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подъем подводных шлангов при постановке на беспричальный налив (слив).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.4. Судовые шлангоприемники должны быть оборудованы фланцами международного образца,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обеспечивающими надежное герметичное присоединение стендеров и грузовых шлангов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.5. На танкере должен быть выбор переходников для обеспечения стендеров и грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шлангов разных диаметров.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.6. На танкере должны быть установлены специальные устройства экстренной остановки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых насосов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.7. На танкере в районе шлангоприемников должна быть специальная стационарная или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 переносная емкость для сбора различных нефтепродуктов. Аналогичные емкости должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 установлены под воздушные трубки топливных цистерн перед проведением бункеровочных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.8. Шпигаты на грузовой палубе должны надежно закрываться на время проведения грузовых и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 балластных операций, а также при мойке танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Рекомендуется применение специальных устройств по локализации и сбору разлитой на палубу}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефти.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.9. Для предотвращения аварийного разлива груза на грузовых трубопроводах танкера должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 устанавливаться клинкеты (задвижки) надежной конструкции, исключающей самопроизвольное их}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрытие и открытие.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.10. Каждый танкер должен быть снабжен достаточным количеством швартовных канатов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обеспечивающих безопасную стоянку в планируемых портах захода при ожидаемых погодных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 условиях, течениях, приливо-отливных явлениях.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 3.11. Для безопасного управления грузовыми, балластными и другими операциями на танкере}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должен быть комплект портативных радиопередатчиков во взрывобезопасном исполнении}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 одобренного типа.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Примечание. Требования к береговому грузовому оборудованию, относящиеся к}\par}{\pard \sl-278\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предотвращению разливов, приведены в Приложении 12.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3420{\tab\f0\cf1\fs24 \b 4. Классификация и свойства нефтепродуктов}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.1. Огнеопасность нефтепродуктов определяется температурой вспышки их паров, т.е. самой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 низкой температурой горючего вещества, при которой над поверхностью образуются пары и газы,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 способные загораться в воздухе от внешнего источника зажигания.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.2. Нефтепродукты по пожаровзрывоопасности в соответствии с ГОСТ 12.1.017-80}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подразделяются на:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 легковоспламеняющиеся вещества - способные воспламеняться от кратковременного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воздействия источника зажигания с низкой энергией;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вещества средней воспламеняемости - способные воспламеняться от длительного воздействия}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 источника зажигания с низкой энергией;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 трудновоспламеняющиеся вещества - способные воспламеняться только под воздействием}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мощного источника зажигания.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.3. К легковоспламеняющимся нефтепродуктам относятся те из них, которые имеют}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 температуру вспышки в закрытом тигле 61 град. C и ниже.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.4. Легковоспламеняющиеся жидкости по температуре вспышки классифицируются:}\par}{\pard \sl-713\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 ----------------------------T------------------------------------¬}\par}{\pard \sl-218\par}{\pard \sl-0\tx735\tx900\tx4965\tx5130\tx10545{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24    Легковоспламеняющиеся   }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 Температура вспышки в тигле, град. C}{\tab\f1\cf1\fs24 ¦}\par}{\pard \sl-218\par}{\pard \sl-0\tx735\tx900\tx4965{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24          жидкости          }{\tab\f1\cf1\fs24 +-----------------T------------------+}\par}{\pard \sl-218\par}{\pard \sl-0\tx735\tx900\tx4965\tx5130\tx7695\tx7860\tx10575{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24                            }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24      закрытом    }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24       открытом    }{\tab\f1\cf1\fs24 ¦}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 +---------------------------+-----------------+------------------+}\par}{\pard \sl-218\par}{\pard \sl-0\tx735\tx900\tx4965\tx5130\tx7695\tx7860\tx10575{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 Особо опасные              }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 t <= -18         }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 t <= -13          }{\tab\f1\cf1\fs24 ¦}\par}{\pard \sl-218\par}{\pard \sl-0\tx735\tx900\tx4965\tx5130\tx7695\tx7860\tx10575{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 Постоянно опасные          }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 23 >= t > -18    }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 27 >= t > -13     }{\tab\f1\cf1\fs24 ¦}\par}{\pard \sl-218\par}{\pard \sl-0\tx735\tx900\tx4965\tx5130\tx7695\tx7860\tx10575{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 Опасные при повышенной     }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 23 < t <= 61     }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 27 < t <= 66      }{\tab\f1\cf1\fs24 ¦}\par}{\pard \sl-218\par}{\pard \sl-0\tx735\tx900\tx4965\tx5130\tx7695\tx7860\tx10575{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24 температуре                }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24                  }{\tab\f1\cf1\fs24 ¦}{\tab\f1\cf1\fs24                   }{\tab\f1\cf1\fs24 ¦}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 L---------------------------+-----------------+-------------------}\par}{\pard \sl-758\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.5. Температура нефтепродуктов при наливе в танкер должна быть ниже температуры вспышки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 не менее чем на 5 град. C, в противном случае любой нефтепродукт следует относить к категории}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 легковоспламеняющихся (летучих).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.6. Темные нефтепродукты (мазут и др.) не создают высокой концентрации газов до тех пор,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пока они не нагреты до температуры, превышающей температуру вспышки.}\par}{\pard \sl-83\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-938\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.7. Пары нефтепродуктов тяжелее воздуха и медленно смешиваются с ним в условиях}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 маловетрия, что способствует опасной загазованности судна во время погрузки и приема балласта в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 недегазированные танки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.8. При обнаружении паров в пустых закрытых пространствах следует особое внимание}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 уделять придонному пространству, где вероятнее всего пары могут накапливаться.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.9. Смесь углеводородов с воздухом не может гореть, если соотношение смеси газов и воздуха}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 находится за пределами двух концентраций, известных как нижний и верхний пределы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрываемости (воспламеняемости).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.10. Зона взрываемости паров углеводородов нефтепродуктов, перевозимых морем,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 практически находится в пределах от 1% смеси паров с воздухом по объему для НПВ и до 10% смеси}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 паров с воздухом для ВПВ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.11. Аналогично объемным пределам взрываемости существуют температурные пределы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрываемости.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Нижний температурный предел взрываемости (воспламенения) у большинства нефтепродуктов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствует температуре вспышки, верхний - температуре нефтепродуктов, при которой упругость}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 насыщенных паров в воздухе эквивалентна концентрации, соответствующей верхнему пределу}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрываемости.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.12. Для определения степени опасности необходимо замерить температуру паров}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов в подпалубном пространстве или самого нефтепродукта в грузовом танке и сравнить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 с имеющимися данными по температурным пределам взрываемости (Приложение 1).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.13. На груженом или недегазированном танкере при плавании в зонах с разной температурой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 атмосферного воздуха и забортной воды, зная температурные пределы взрываемости погруженного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродукта, следует принять нужные меры безопасности (см. Приложение 1).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.14. Если температура находящихся в грузовых танках паров нефтепродуктов поднялась выше}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нижнего температурного предела взрываемости, для охлаждения подпалубного пространства}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо включить в работу систему орошения палубы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.15. Температура самовоспламенения нефтепродуктов, при которой их пары воспламеняются}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 без применения открытого огня, является характеристикой степени пожарной опасности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Температура самовоспламенения многих бункерных видов топлива и смазочных масел}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 относительно низкая, поэтому нельзя допускать, чтобы они попадали на горячую поверхность}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 механизмов в машинно-котельном отделении, что может вызвать их загорание, несмотря на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсутствие открытого огня.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.16. Нефтепродукты восприимчивы к образованию в них опасных зарядов статического}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электричества, что необходимо учитывать при производстве грузовых и балластных операций (см. п.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 17 "Предотвращение образования опасных зарядов статического электричества"):}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.16.1. Бензины, керосины, а также дизельные топлива и масла являются восприимчивыми к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 образованию опасных зарядов статического электричества благодаря их низкой проводимости.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.16.2. Сырые нефти, мазуты, содержащие большое количество примесей, значительно меньше}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 аккумулируют в себе заряды электричества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Когда в нефтепродуктах присутствует даже небольшое количество воды во взвешенном}\par}{\pard \sl-338\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 состоянии, а также воздуха или окислов металлов, их опасность к образованию опасных зарядов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 статического электричества резко увеличивается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.17. Скорость образования и величина электрических зарядов в большой степени зависят от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вязкости нефтепродуктов: чем больше вязкость, тем меньше способность к насыщению статическим}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электричеством.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.18. В нефтепродуктах опасные величины потенциалов статического электричества образуются}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 при:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 движении по трубопроводам со скоростью, превышающей 1 м/с (см. разд. I, п. 17.10);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 свободно падающей струе груза (погрузка "через верх");}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 продувании сжатым воздухом или паром грузовых шлангов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.19. Нефтепродукты и их газы обладают ядовитыми свойствами и при несоблюдении правил}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обращения с ними могут вызвать отравления. Газы нефтепродуктов проникают в организм человека с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воздухом при вдыхании, через кожу и пищеварительный тракт.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.20. Первые признаки отравления нефтяными газами напоминают симптомы опьянения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (повышенная веселость, желание петь, головокружение, пониженное чувство ответственности).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При входе в помещение с большим содержанием паров нефтепродуктов (36 - 45 мг/л)}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отравление происходит очень быстро, что может привести к прекращению дыхания, остановке}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сердца и смерти.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Запрещается посылать человека в отсек без предварительного анализа воздуха}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 газоанализатором.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Только в те отсеки, где содержание нефтяных паров не превышает санитарной нормы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (Приложение 2), можно посылать человека без автономного дыхательного противогаза (см. разд. I, п.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 19).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.21. В состав некоторых сортов нефти входит опасный газ - сероводород. Если содержащийся в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузе сероводород находится в концентрациях, опасных для вдыхания, грузоотправитель обязан}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 уведомить об этом капитана танкера в письменной форме.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.22. При производстве грузовых операций и транспортировке грузов, содержащих сероводород,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или при приемке балласта после выгрузки таких грузов необходимо принимать дополнительные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 меры безопасности, указанные в разд. I, п. 14 настоящих Правил.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 4.23. Этилированные нефтепродукты отличаются от обычных тем, что к ним для улучшения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 антидетонационных свойств добавляется ядовитая этиловая жидкость (тетраэтилсвинец).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При перевозке на танкерах этиловой жидкости и этилированных нефтепродуктов необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соблюдать специальные санитарные правила, утвержденные органами здравоохранения, и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 принимать дополнительные меры безопасности, указанные в разд. I, п. 14 настоящих Правил.}\par}{\pard \sl-818\par}{\pard \sl-0\tx2985{\tab\f0\cf1\fs24 \b 5. Обмен информацией перед приходом танкера в порт}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 5.1. До прихода танкера в порт следует заблаговременно обменяться информацией между}\par}{\pard \sl-143\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судном и портом по вопросам, связанным с безопасностью судна и причала и предотвращением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загрязнения моря.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 5.2. Капитан судна должен сообщить порту:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 осадку и дифферент судна на момент прихода в порт;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 о требуемой помощи буксиров;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 наличие водотечности в корпусе, переборках, трубопроводах, которая может явиться причиной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загрязнения моря;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 место расположения шлангоприемников и размеры фланцев, если они не соответствуют}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 принятым стандартам;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 количество грязного и чистого балласта на борту танкера и необходимое время на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дебалластировку.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 5.3. Порт должен сообщить судну:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 наличие буксиров и плавсредств, которые могут быть использованы при швартовке;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 специальные швартовные предосторожности, включая глубину у причала;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 наличие швартовных канатов и приспособлений, которые судну необходимо иметь для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 швартовных операций;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 грузоподъемность судовой стрелы, требующейся для работы со шлангами, если предстоят}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рейдовые грузовые операции;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 диаметр грузовых шлангов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 расположение береговых грузовых приемников;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 возможность приема берегом балласта, находящегося на борту судна;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 план швартовки;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 другую информацию, относящуюся к обеспечению безопасной работы судна.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4140{\tab\f0\cf1\fs24 \b 6. Подготовка танкера к погрузке}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.1. Общее руководство и контроль за соблюдением на судне правил перевозки грузов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проведением всех грузовых и балластных операций, выполнением работ по подготовке танков,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ведением грузовой документации осуществляется капитаном судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.2. Порядок подготовки танков к наливу нефти и нефтепродуктов осуществляется в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствии с ГОСТ 1510-84.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.3. Подготовка танкера к грузовым операциям должна начинаться до прихода в порт, когда}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судно следует в балласте из порта выгрузки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.4. По получении задания на предстоящий рейс помощник капитана, ответственный за}\par}{\pard \sl-293\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проведение грузовых операций, составляет грузовой план с учетом данных информации об}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 остойчивости и прочности и согласовывает его, а также технологическую карту, отражающую}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 технологию проведения предстоящих грузовых операций, со старшим помощником капитана.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.5. Грузовой план, согласованный с грузоотправителем, и технологическая карта утверждаются}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 капитаном до начала налива и принимаются помощником капитана, ответственным за проведение}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых операций, к исполнению. В дальнейшем всякие изменения в грузовом плане и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 технологической карте вносятся только с ведома капитана.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.6. Грузовой план должен обеспечивать:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 а) мореходность судна и сохранность перевозимого груза;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 б) расчетные осадку и дифферент после окончания погрузки груза и всего снабжения (бункера,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пресной воды и т.д.);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 в) максимально полное использование грузоподъемности и грузовместимости судна;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 г) остойчивость судна и безопасное для прочности корпуса распределение груза по танкам на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 всех стадиях рейса;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 д) безопасное для разных сортов груза распределение по танкам с учетом разделения разных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сортов груза не менее чем двумя закрытыми клинкетами;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 е) необходимый дифферент на корму при предстоящей частичной выгрузке одного из сортов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груза для обеспечения мореходных качеств судна и создания условий для полной зачистки танков;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 ж) сохранность груза в танках при его расширении от изменения температурных условий во}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 время плавания;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 з) нормальную выгрузку груза с учетом запланированных заходов в порты назначения и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обеспечения мореходных качеств судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В случае невозможности составления грузового плана, отвечающего всем указанным}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требованиям по выданному диспетчером наряду, капитан должен немедленно информировать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пароходство, которое должно дать дополнительные указания.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.7. В технологической карте должны быть конкретно указаны: последовательность погрузки по}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкам, по какой магистрали должен приниматься груз, какие клинкеты должны быть открыты и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 какие закрыты до начала данной операции, а также все действия по безопасному проведению}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Для предотвращения возможных разливов груза необходимо выбирать такой вариант}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 технологии погрузки, в котором нужно делать меньше переходов с танка на танк в процессе налива.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Технологическая карта должна составляться с учетом обеспечения пожарной безопасности,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прочности корпуса, мореходности танкера, исключения переливов и смещения груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.8. Контроль за размещением груза или балласта по танкам с целью недопущения завышенных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 напряжений корпуса осуществляется старшим помощником капитана.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.9. На основании утвержденного капитаном грузового плана старший помощник капитана}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 организует работы по подготовке грузовых танков к наливу запланированного груза (мойка,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 зачистка). Мойку грузовых танков следует выполнять, руководствуясь РТМ 31.2006-78 "Мойка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых танков и топливных цистерн танкеров" и графиками, разработанными применительно к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 каждому типу судна, с учетом выполнения требований ГОСТ 1510-84, а также с соблюдением}\par}{\pard \sl-113\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требований действующей Конвенции по предотвращению загрязнения с судов 1973 г.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.10. Требования на производство дополнительных операций по мойке и зачистке грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков, не предусмотренных ГОСТ 1510-84, должны быть заявлены грузоотправителем капитану в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 письменном виде и должны выполняться после подтверждения пароходством.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.11. Порядок подготовки танков под налив груза на экспорт производится по ГОСТ 1510-84,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 если фрахтователь не предъявил иных требований.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.12. Если вследствие замены отправителем запланированного к погрузке сорта груза возникает}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимость в дополнительной или специальной мойке и зачистке танков, эти работы производит}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судно по указанию пароходства на основании письменного заявления грузоотправителя.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.13. Прием танков после мойки производится помощником капитана, осуществляющим}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовые операции, совместно со старшим помощником капитана и специально выделенной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 комиссией по указанию капитана.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.14. Старший помощник капитана не реже чем один раз в 3 мес. должен производить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 внутренний осмотр грузовых танков и тщательную проверку надежности крепления трапов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поручней, трубопроводов, штоков, клинкетов и другого оборудования.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.15. Выборку из грузовых танков скопившейся на днище ржавчины, особенно из шпаций, где}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 расположены приемные храпки, необходимо производить в коротких рейсах не реже чем через 3}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мес., а в продолжительных (больше 3 мес.) - после каждого рейса.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.16. Не реже одного раза в 3 мес. необходимо контролировать исправность и состояние}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пламепреградителей и заслонок на газоотводной системе. Их закоксованность и замазученность могут}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 явиться причиной повышения давления в танках сверх допустимого.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.17. Периодически, не реже чем через 6 мес., производить проверку змеевиков системы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подогрева груза на герметичность. Необходимо продувать и проверять на герметичность змеевики}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подогрева перед каждой погрузкой груза, требующего подогрева, и при смене вида светлых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.18. В период подготовки судна к погрузке необходимо произвести тщательную очистку}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 фильтров, установленных на грузовой магистрали и у грузовых и зачистных насосов. Грязные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 фильтры могут явиться причиной опасного повышения давления в грузовых шлангах и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопроводах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.19. Ежерейсно производить проверку состояния сальников грузовых и зачистных насосов, а}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 также сальников клинкетов, расположенных в насосном отделении и на грузовой палубе, на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсутствие утечек. На коротких рейсах, не более 3 сут., один раз в месяц.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.20. До начала грузовых операций проверить систему судовой сигнализации и средства}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожаротушения и сделать запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.21. Перед началом грузовых операций проверить все клинкеты грузовой системы на полное}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрытие и открытие, а также на легкость хода. Если танкер оборудован дистанционной системой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открытия-закрытия грузовых клинкетов, необходимо произвести проверку на потребное время для их}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открытия и закрытия, особенно в холодное время года, когда загустевшее в системе масло может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 намного увеличить время открытия-закрытия.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В помещении управления клинкетами должна быть вывешена таблица времени открытия и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрытия каждого клинкета, определенного опытным путем.}\par}{\pard \sl-443\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.21.1. Система дистанционного управления грузовыми клинкетами должна всегда находиться в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 эксплуатационном состоянии и ее использование должно осуществляться в строгом соответствии с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инструкцией завода-изготовителя.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.22. На судах, оборудованных автоматической системой замера груза, необходимо до начала}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погрузки проверить исправность и надежность действия системы, после чего установить указатели}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 на приборах соответственно заданным уровням груза по танкам. Использование системы во время}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проведения грузовых операций производить в строгом соответствии с инструкцией завода-}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изготовителя.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.23. Ежерейсно проверять закрытия дистанционных клапанов систем углекислотного и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пенного тушения и, если будут обнаружены вода или остатки груза, осушить через спускные пробки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 магистральный трубопровод углекислотной и пенной систем.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.24. Ежерейсно проверять дистанционные клапаны системы инертных газов на герметичность.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.25. До начала погрузки открыть дыхательные клапаны газоотводной системы (давление -}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вакуум). По окончании грузовых операций дыхательные клапаны устанавливаются в автоматический}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 режим.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.26. При подготовке танкера к погрузке нескольких сортов груза необходимо проверить на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 герметичность те переборки, между которыми предполагается размещать грузы разных сортов.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Опрессовать клинкеты грузовой и зачистной магистралей на отсутствие пропусков, о чем сделать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.27. Секущие клинкеты грузовой и зачистной магистралей, расположенные между танками с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разными сортами груза, должны быть плотно обжаты, перевязаны и опломбированы под}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 руководством помощника капитана, осуществляющего грузовые операции. Об этом должен быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 составлен акт и сделана запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.28. Ежерейсно перед постановкой танкера под погрузку судовая комиссия, назначенная}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 капитаном, составляет технический акт о производстве проверки состояния грузового оборудования}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкера, устранении выявленных дефектов и исправности грузовой системы танкера. О}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 произведенном осмотре делается запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.29. Перед погрузкой закрыть и плотно обжать все крышки танковых горловин, лючки для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мойки танков, замерные трубки в грузовых танках. Смотровые глазки должны быть закрыты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.30. Для предотвращения попадания паров нефтепродуктов в судовые помещения необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перед погрузкой выполнить следующие работы:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.30.1. Иллюминаторы, люки и двери переборок юта, полубака, средней надстройки, машинно-}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 котельного отделения, камбуза плотно закрыть.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.30.2. Систему кондиционирования воздуха переключить на работу по замкнутому циклу или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выключить.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.30.3. Оконные кондиционеры вынуть, а окна плотно закрыть.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.30.4. Раструбы вентиляторов судовых помещений развернуть по ходу относительно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 направления ветра, чтобы работать на вытяжение, или закрыть.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.31. Перед началом грузовых операций на грузовой палубе в районе шлангоприемников}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 организовать пожарный пост со следующим минимальным противопожарным инвентарем:}\par}{\pard \sl-533\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 ручные огнетушители - 2 шт.;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 кошма, войлок - 2 шт.;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 ящик с песком и лопата.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 К месту работы проложить рукавную пенную линию с пенным стволом или пеногенератором и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 водяную рукавную линию со стволом-распылителем.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.32. Перед погрузкой все палубные шпигаты должны быть надежно закрыты во избежание}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 попадания нефтепродуктов за борт в случае перелива.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 6.33. С приходом в порт капитан обязан получить от представителя порта полную информацию}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 о местных правилах и постановлениях, касающихся предотвращения загрязнения окружающей среды.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 С полученной информацией ознакомить весь экипаж танкера.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4785{\tab\f0\cf1\fs24 \b 7. Погрузка у причала}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.1. Для проведения грузовых операций танкер должен быть надежно ошвартован. Подано}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 достаточное количество швартовных канатов так, чтобы исключить движение судна вдоль причала, а}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 также отрыв судна от причала при ухудшении метеоусловий.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В тех портах, где наблюдаются сильные течения и шквалы, рекомендуется использовать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 швартовные канаты с небольшой степенью растяжения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.2. Использование швартовных лебедок в автоматическом режиме работы в каждом порту}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 согласовывается капитаном танкера с представителем наливного причала. Если ожидается ухудшение}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погоды, автоматические лебедки должны быть переведены на ручное управление, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 самопроизвольное потравливание швартовных канатов не привело к разрыву грузового шланга или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поломке стендера и разливу груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.3. Для того, чтобы устранить возможность образования опасной электрической искры у}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судового шлангоприемника при присоединении или рассоединении грузового шланга, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чтобы все металлические части грузового шланга с морской стороны от изолирующего фланца или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токонепроводящего шланга были непрерывно электрически связаны с судном, а все металлические}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 части грузового шланга с береговой стороны от изолирующего фланца - с причальной заземляющей}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 системой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.4. Изолирующие фланцы и токонепроводящие шланги должны периодически проходить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверку на обеспечение хорошей изоляции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.5. Грузовой шланг, подаваемый на борт танкера, должен удовлетворять следующим}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требованиям:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 разрывное давление должно быть не менее 4,2 МПа (42 кгс/кв. см) или, по крайней мере, в 4}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 раза превышать максимальное давление, развиваемое грузовыми насосами;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 рабочее давление должно быть не менее максимального давления, развиваемого насосами, но}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 не менее 1 МПа (10 кгс/кв. см).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.6. Каждый грузовой шланг должен иметь спецификацию изготовителя, в которой должно быть}\par}{\pard \sl-353\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 указано:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 для каких грузов может быть использован шланг;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 дата изготовления;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 величина разрывного давления;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 величина рабочего давления;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 дата последнего испытания и величина давления при испытании.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Допускаются надписи на самом шланге с указанием этих данных.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.7. Если грузовые шланги, принадлежащие нефтебазе и предназначенные для подачи на борт}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкера, имеют видимые дефекты (разрезы, вмятины, выпучины, трещины и др.) или сильно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изношены, капитан танкера должен заявить об этом ответственному представителю нефтеналивного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 причала в письменной форме и сделать соответствующую запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В противном случае, если произойдет разрыв шланга во время проведения грузовых операций,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ответственность за разлив груза может быть возложена на судно.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.8. Перед присоединением грузовых шлангов к судовым приемникам необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 удостовериться, что шланги имеют достаточную длину с учетом изменения осадки судна в процессе}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых операций, а также возможного перемещения судна вдоль причала и от причала на величину}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 растяжения швартовных канатов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.9. Стендеры и грузовые шланги необходимо подавать на борт судна только с заглушенными}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 фланцами. При подъеме шлангов на танкер избегать их заломов и других повреждений. Заглушки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отдавать над поддонами, чтобы не допустить разлива груза на палубу и за борт.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.10. При присоединении стендеров и грузовых шлангов к судовым приемникам ключи,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 струбцины и другой инструмент необходимо класть на специальные маты, расстилаемые временно у}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 места работы, чтобы избежать ударов о стальную палубу. Крепить шланги к приемникам необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 надежно не менее чем четырьмя болтами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.11. Чтобы исключить возможность заломов или защемления грузовых шлангов между судном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и причалом, а также их трения о причал или поручни судна, шланги должны поддерживаться на весу}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовой стрелой танкера или причала при помощи специальной подвески.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.12. При подаче на борт танкера стендера необходимо на причале получить информацию о}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасных пределах его перемещения, чтобы определить и поддерживать величину допустимого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасного перемещения судна вдоль причала, а также величину безопасного для стендера крена}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Во время погрузки необходимо своевременно выбирать слабину швартовных канатов, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предотвратить поломку стендера или разрыв грузового шланга.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.13. При работе со стендерами танкеру необходимо выполнять следующие требования:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 танкер должен быть пришвартован так, чтобы его шлангоприемники были расположены против}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 стендеров;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 швартовные канаты должны быть всегда хорошо обтянуты и не иметь слабины;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 там, где к судовым приемникам должны быть добавлены трубы-удлинители, они должны быть}\par}{\pard \sl-293\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 надежно закреплены, чтобы исключить возможную вибрацию и чрезмерное напряжение в стендерах}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и грузовом трубопроводе танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.14. При предъявлении грузовых танков представителю грузоотправителя для удостоверения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 их пригодности к наливу запланированного груза осмотр танков должен делаться с соблюдением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 правил техники безопасности, регламентирующих вход в закрытые помещения (см. разд. I, п. 19).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.15. После подтверждения пригодности танков к наливу запланированного груза все клинкеты}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовой и зачистной систем танкера, включая и клинкеты насосного отделения, кроме тех, которые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 будут участвовать при начале погрузки, необходимо закрыть под личным руководством помощника}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 капитана, ответственного за проведение грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.16. На танкерах, где вентиляция грузовых танков осуществляется через грузовой трубопровод,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо соблюдать инструкцию по ее эксплуатации, исключая возможность попадания}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтегруза в насосное отделение.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.17. На все неиспользуемые при погрузке приемники палубного грузового трубопровода,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 включая кормовой, должны быть поставлены заглушки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.18. Клапаны кингстонов и отливные забортные клинкеты на грузовом трубопроводе должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть плотно закрыты и опломбированы с участием представителя нефтебазы, о чем составляется акт}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и производится запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.19. Пустое пространство в трубе между кингстоном и секущим клинкетом рекомендуется}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 контролировать специальным прибором, оповещающим судовой персонал о появившейся течи в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 одном из этих запорных устройств.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.20. Скопившуюся на грузовой палубе с закрытыми шпигатами воду (например, дождевую)}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо периодически удалять.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.21. При наличии на танкере системы инертных газов перед погрузкой грузовые танки должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть заполнены инертными газами с температурой и процентным содержанием кислорода,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 указанными в заводской инструкции на систему.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.22. До начала погрузки грузовой помощник капитана совместно с представителем нефтебазы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 согласовывают план погрузки, в котором должны быть указаны:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 последовательность грузовых операций;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 интенсивность погрузки - начальная, максимальная, при переходе с одной группы танков на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 другую, при окончании погрузки;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 максимально допустимое давление в береговых грузовых шлангах или стендерах;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 время, потребное для пуска, остановки или изменения интенсивности грузовых операций;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 по чьей команде будет остановлена вся погрузка;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 сигналы и командные слова, применяемые в данном порту при начале, остановке погрузки;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 меры по предотвращению загрязнения моря;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 порядок выполнения чрезвычайных действий при разливах нефти;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 ответственные за проведение грузовых операций лица от судна и берега и место нахождения их}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 во время грузовых операций (Приложение 4).}\par}{\pard \sl-293\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Четкое взаимодействие берегового и судового персонала в процессе грузовых операций и в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 аварийных ситуациях - одна из наиболее эффективных мер против разливов нефти.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.23. Средства специальной связи танкера с нефтебазой - телефоны, переносные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 радиопередатчики и др., применяемые в данном порту для регулирования грузовых операций и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 аварийной остановки погрузки, должны быть совместно опробованы помощником капитана,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ответственным за проведение грузовых операций, и представителем нефтебазы до начала грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операций и находиться включенными во время проведения грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Помощник капитана должен знать номер и место телефона на причале для вызова береговой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожарной команды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.24. При проведении погрузки рекомендуется пользоваться следующими командными словами:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 приготовиться (STAND BY);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 начать погрузку (START LOADING);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 грузить полным ходом (FULL SPEED LOADING);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 уменьшить погрузку (SLOW DOWN);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 стоп погрузка (STOP LOADING);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 срочная остановка (EMERGENCY STOP).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.25. На танкере, на котором нет стационарного замерного устройства, смотровые лючки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открываются для замера груза только в тех танках, в которые принимается груз. При открытии}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 крышки смотровой глазок должен быть постоянно закрыт двойной пламепрерывающей сеткой,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 напаянной на медный ободок (ГОСТ 3826-82).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.26. Кратковременное снятие пламепреградительной сетки со смотрового лючка разрешается}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 только для замера уровня груза и отбора проб.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.27. В портах, где это требуется местными правилами, перед началом грузовых операций с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 целью обеспечения более надежной безопасности и взаимопонимания ответственные представители}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна и нефтепричала совместно проводят проверку выполнения необходимых мер безопасности на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борту танкера и на причале. Эта проверка обычно оформляется подписанием обеими сторонами}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверочного листа с контрольными вопросами, вручаемого капитану танкера представителем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтеналивного причала (см. Приложение 4).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.28. Капитан не должен начинать погрузку при отсутствии на судне полной информации о}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузе, его опасных свойствах. Грузоотправитель несет полную ответственность за правильность}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сведений, сообщенных им о грузе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.29. Налив нефтепродуктов с температурой вспышки ниже 61 град. C должен производиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 только путем глухого соединения фланцев грузовых шлангов с приемной трубой грузовой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 магистрали, не допускающей свободного падения струи груза в танк.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.30. Нефтепродукты с температурой вспышки выше 61 град. C разрешается грузить через}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 горловины грузового танка. В этом случае грузовой шланг должен быть опущен до днища танка, не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 иметь металлического фланца на свободном конце. Горловина танка должна быть закрыта брезентом,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 смоченным водой, а под шланг уложен мат во избежание его трения о комингс горловины.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.31. Нефтепродукты с температурой вспышки паров выше 61 град. C можно грузить "через верх"}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 при следующих обязательных условиях:}\par}{\pard \sl-113\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-908\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 если танк дегазирован и в нем отсутствуют остатки летучих нефтепродуктов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 при согласии капитана и представителя нефтебазы на проведение этой операции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.32. При наливе закрытым способом, с закрытыми смотровыми лючками, когда газы из танков}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выпускаются только через газоотводную систему, должны выполняться следующие требования:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 обеспечить надежную работу дистанционных систем для замера уровня груза в танках и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 показания давления в танках с системами сигнализации, срабатывающими при подходе груза к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заданному уровню и при повышении давления сверх допустимого;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 до начала погрузки убедиться в том, что газоотводные трубы, огнепреградители и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пламепрерывающие сетки очищены от окалины и отвердевших нефтеостатков от предыдущих рейсов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 погрузку производить при открытых дыхательных клапанах на газоотводной системе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.33. На танкерах, оборудованных автоматической системой погрузки, во время налива следить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 за исправностью работы автоматических блокировок очередности открытия клинкетов по}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заполнению танков и прекращению их налива при достижении заданного верхнего уровня в танках.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При подозрении на неисправную работу автоматической системы во избежание перелива груза}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо перейти на ручное управление наливом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.34. Перед тем как дать команду на берег о начале погрузки, помощник капитана,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ответственный за проведение грузовых операций, должен еще раз проверить выполнение следующих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 профилактических требований:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 извещены ли о начале грузовых операций судовой и береговой персонал;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 имеются ли предупредительные надписи на судне в соответствии с требованиями п. 2.1;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 удалены ли посторонние лица с борта судна;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 извещены ли о начале грузовых операций стоящие у борта плавсредства, имеющие на это}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разрешение;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 отошли ли от борта плавсредства, не имеющие на это разрешение;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 прекращены ли запрещенные работы на борту судна (см. п. 2.20);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 прекращена ли работа судовых радиопередатчиков и локаторов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 подготовлены ли к грузовым операциям судовые магистрали.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.35. Прием бункерного топлива с плавсредств в целях сокращения стояночного времени}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкера разрешается одновременно с производством грузовых операций при выполнении мер,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изложенных в Приложении 7.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.36. Число членов экипажа, постоянно несущих вахту во время погрузки, должно обеспечить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасное проведение грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.37. Члены экипажа, участвующие в грузовых операциях, должны иметь практические навыки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обращения с грузом, запланированным к погрузке, и хорошо знать грузовую систему данного танкера,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 а также до начала погрузки должны быть ознакомлены с технологической картой и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проинструктированы о своих обязанностях.}\par}{\pard \sl-518\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.38. Одновременно принимать груз следует только в такое количество грузовых танков, за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 которыми может быть установлено надежное наблюдение и обеспечены условия достаточно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быстрых операций по предупреждению переливов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.39. Помощник капитана, ответственный за проведение грузовых операций, должен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 договориться с представителем берега о начале погрузки сниженной интенсивностью (не более 1}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 м/с). При этом клинкеты на танкере должны быть полностью открыты. После проверки правильности}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поступления груза в запланированные танки, при отсутствии пропусков груза в смежные танки,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 насосное отделение и коффердамы и после достижения уровня груза в 1 м, если груз}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электростатически активен, интенсивность налива может быть доведена до плановой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.40. Если в первый момент погрузки давление в грузовом трубопроводе резко повышается,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо немедленно остановить погрузку и еще раз проверить правильность открытия всех}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клинкетов, участвующих в грузовой операции, и только после этого возобновить грузовые операции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.41. При появлении течи в грузовом шланге или грузовом трубопроводе грузовые операции}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо немедленно остановить до устранения течи.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.42. В случае перелива нефтепродуктов во время проведения грузовых операций капитан или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вахтенный помощник капитана объявляет общесудовую тревогу, прекращает грузовые операции и,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соблюдая меры пожарной безопасности, приступает к уборке разлитых нефтепродуктов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 руководствуясь оперативным планом по борьбе с разливами. Сообщает о переливе ответственному}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 представителю берега и в пожарную охрану порта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.43. Экипаж танкера обязан принять все возможные меры, предупреждающие попадание нефти}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в портовые воды. Смывать с палубы нефтепродукты за борт запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.44. Во время проведения грузовых операций давление в грузовом трубопроводе не должно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 превышать давления, указанного в нотисе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.45. Пребывание на грузовой палубе лиц, не связанных с грузовыми операциями, запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Путь от забортного трапа до переходного мостика должен быть устлан дорожками и ограничен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 леерным устройством.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.46. После начала и в процессе грузовых операций постоянно осматривать поверхность воды}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вокруг танкера на предмет отсутствия течи, уделяя особое внимание району, где расположены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 кингстоны грузового насосного отделения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При обнаружении на поверхности моря нефти грузовые операции должны быть немедленно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 остановлены. Их можно возобновить только после обнаружения и устранения неисправностей,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 повлекших за собой пропуски нефти.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.47. О появившейся в процессе грузовых операций вблизи стоянки судна на поверхности воды}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 плавающей нефти не по вине танкера необходимо проинформировать береговой персонал и сделать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующую запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.48. Система вентиляции насосного отделения должна быть включена все время, пока идут}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовые операции. В целях исключения газообразования нельзя допускать скопления}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов в льялах насосного отделения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.49. Посещение насосного отделения во время проведения грузовых операций запрещается без}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предварительного предупреждения вахтенного помощника капитана и установления постоянного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 наблюдения за находящимся в насосном отделении. Вблизи насосного отделения необходимо все}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 время держать в готовности два комплекта шланговых противогазов, спасательных поясов и}\par}{\pard \sl-143\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 страховочных канатов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.50. При резком ухудшении погоды и других обстоятельствах, создающих опасность разрыва}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шлангов или повреждения шлангующего устройства, грузовые операции немедленно прекратить.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.51. Если в процессе погрузки обнаружится, что какие-то из мер предосторожности или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 технических условий работниками берега не выполняются или выполняются недостаточно полно,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помощник капитана, ответственный за проведение грузовых операций, обязан своевременно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 доложить капитану, который должен обратить на это внимание ответственного представителя}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепричала и потребовать немедленного устранения обнаруженных упущений с их стороны.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Кроме того, необходимо сделать соответствующую запись в судовом журнале, чтобы в случае}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 происшедшего разлива груза не по вине судна можно было отклонить необоснованные претензии}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (см. Приложение 4).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.52. Во время проведения грузовых операций все клинкеты грузовой системы танкера должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открываться и закрываться по личному указанию помощника капитана, осуществляющего грузовые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.53. При грозовых разрядах в непосредственной близости от танкера необходимо прекратить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовые операции, проведение дегазации и мойку танков, а также закрыть все палубные отверстия.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.54. Если во время проведения грузовых операций из дымовой трубы начнут падать искры,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо остановить грузовые операции и смочить грузовую палубу забортной водой, а также}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверить исправность и регулировку работы искрогасителя.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.55. Во время проведения грузовых операций пожарная водяная магистраль должна быть все}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 время под давлением. Если это невозможно сделать, то должен быть готов к немедленному}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 включению в работу пожарный насос.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.56. При погрузке, при переходе с полных танков на пустые необходимо заблаговременно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приоткрыть ("подорвать") клинкеты пустых танков на один-два оборота.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.57. При погрузке для предупреждения опасного повышения давления в грузовых шлангах и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопроводах необходимо придерживаться правила: "на сколько прикрывается клинкет одного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танка, приблизительно на столько же открывается клинкет другого". В любой момент погрузки на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 каждой грузовой магистрали танкера, как минимум, должно быть открыто полностью не менее}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 одного клинкета.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.58. При интенсивной погрузке клинкеты необходимо закрывать плавно, чтобы не создать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опасного повышения давления в грузовом трубопроводе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.59. Для надлежащего закрытия клинкетов во время погрузки рекомендуется после закрытия}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клинкета до упора снова слегка приоткрыть его (на один-два оборота), чтобы потоком груза смыть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможно попавшие под него кусочки ржавчины или другие посторонние частицы, нарушающие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 плотность закрытия; затем снова закрыть до упора.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Плотность закрытия клинкетов при ручном управлении необходимо контролировать по}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 указателю, находящемуся на штоке клинкета.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.60. Если при переходе трубопроводов с груженого танка на пустой его клинкет по какой-то}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 причине "заело" и он не открывается, во избежание перелива необходимо немедленно открыть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клинкет другого ближайшего пустого танка, чтобы отвести поток груза от полного танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.61. Если клинкеты грузовой системы танкера открываются недостаточно быстро, то при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 большой норме погрузки при переходе с одних танков на другие, чтобы не допустить избыточного}\par}{\pard \sl-143\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 давления, необходимо на это время норму погрузки уменьшить, предварительно согласовав этот}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вопрос с представителем берега.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.62. Рассчитывая минимальные пустоты, которые требуется оставить в загруженных танках,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо учитывать конструкцию подпалубного набора, чтобы избежать риска перелива груза в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 конце погрузки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.63. Для контроля помощнику капитана, ответственному за проведение грузовых операций, на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 крышке расширителя каждого танка рекомендуется написать мелом запланированную пустоту, до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 которой танк должен грузиться.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.64. Пустоты в танках во всех случаях должны быть оставлены с учетом возможного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 расширения груза в пути следования вследствие повышения температуры воздуха и забортной воды}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или вследствие подогрева груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.65. Во время погрузки необходимо проводить проверки, чтобы убедиться, что груз}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов поступает только в предназначенные грузовые танки и не поступает в насосное}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отделение, коффердамы или за борт через кингстоны и забортные отливные клинкеты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.66. В конце погрузки необходимо периодически контролировать показания приборов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дистанционного замера уровня груза путем сравнения с замерами футштоком.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.67. При подозрении на неисправность работы системы дистанционного замера уровня груза в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танках и системы автоматического налива во избежание перелива груза необходимо перейти на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ручное управление погрузкой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.68. Во время погрузки вахтенные матросы обязаны следить за уровнем груза в танках и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заблаговременно, до подхода груза до заданной помощником капитана пустоты, докладывать ему об}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 этом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.69. К концу налива каждого танка или группы танков интенсивность налива должна быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 снижена своевременным открытием клинкетов смежных танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.70. Вести погрузку танкера необходимо таким образом, чтобы окончание загрузки каждого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танка проходило поочередно, в разное время. Если загрузка нескольких танков будет заканчиваться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 одновременно, можно не успеть вовремя переключить поток груза с полных в пустые танки и в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 результате возможен перелив груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.71. Для исключения опасности перелива груза в конце погрузки должна быть снижена}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 интенсивность налива до предела, обеспечивающего контроль за уровнем груза в танках, которые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 догружаются последними. При этом необходимо с представителем берега оценить ориентировочно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 количество груза, которое может поступить на танкер после сигнала о прекращении налива до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 полного закрытия береговых клинкетов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.72. Погрузку необходимо планировать так, чтобы налив по возможности заканчивался в танки,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в которых оставляются наибольшие пустоты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.73. Помощник капитана, ответственный за проведение грузовых операций, должен следить за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тем, чтобы судно было загружено с соблюдением расчетных осадки и дифферента.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.74. Окончание погрузки должно производиться остановкой береговых насосов и закрытием}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клинкетов на береговом трубопроводе. Клинкеты на судовом грузовом трубопроводе закрываются}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 после прекращения подачи груза с берега.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В аварийных случаях, при угрозе перелива груза из грузовых танков клинкеты на судовой}\par}{\pard \sl-233\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовой магистрали закрываются немедленно независимо от того, успели закрыть клинкеты на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 берегу или нет.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.75. После окончания грузовых операций необходимо плотно закрыть и обжать крышки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 горловин танков, смотровые лючки, замерные трубки и клинкеты грузовой системы, а на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шлангоприемники поставить заглушки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.76. После окончания погрузки клапаны газоотводной системы должны быть переключены на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 автоматический режим.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.77. Необходимо принять все меры, чтобы при отсоединении грузовых шлангов и стендеров не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 произошло разлива остатков груза на палубу, для чего шланги и стендеры должны быть хорошо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 осушены до их отдачи.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.78. Отсоединение грузовых шлангов от судовых приемников следует начинать с нижней части}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 фланца.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.79. Прежде чем убирать с палубы грузовые шланги, на их фланцы должны быть поставлены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заглушки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 7.80. Танкерам, груженным легковоспламеняющимися нефтепродуктами, после окончания}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых операций оставаться у причала не разрешается. Они должны быть выведены на внешний}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рейд.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3870{\tab\f0\cf1\fs24 \b 8. Беспричальная погрузка и выгрузка}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.1. Все правила для танкера, производящего погрузку у причала, обязательны для танкера,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 принимающего груз на рейде на беспричальном наливе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.2. Рейдовая стоянка должна обеспечить безопасное проведение грузовых операций при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ожидаемых условиях волнения моря и ветра и обеспечивать отход танкера в любое время суток, если}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в этом возникает необходимость.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.3. Планируя проведение грузовых операций у беспричального налива, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предварительно проверить соответствие судовых грузоподъемных устройств массе подводного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузового шланга.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.4. Порядок швартовки на рейдовые бочки, количество потребных швартовных канатов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проводников и скоб должны быть согласованы с прибывшим лоцманом до прихода к месту}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 швартовки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.5. До начала швартовки необходимо согласовать с грузителем визуальные и звуковые сигналы,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 каналы радиосвязи, которые будут применяться во время швартовных и грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.6. До прихода танкера к месту швартовки должны быть подготовлены и проверены все}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 оборудование и приспособления, проверены в работе швартовные лебедки и брашпиль.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.7. При приближении к месту швартовки танкер должен быть соответствующим образом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 забалластирован и приняты меры предосторожности для предотвращения навала танкера на бочки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или шланги.}\par}{\pard \sl-563\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.8. При стоянке на бочках все швартовные канаты должны быть туго обтянуты, швартовные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 лебедки, если они использовались, должны быть поставлены на ручное управление, а ленточные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тормоза хорошо обжаты. Из-за больших нагрузок автоматические устройства швартовных лебедок}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны быть отключены.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.9. Во время проведения грузовых операций, когда осадка судна быстро меняется, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 внимательно следить за натяжением швартовных канатов, чтобы судно не меняло своего положения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 относительно подводных шлангов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.10. Во время стоянки танкера на бочках судовые гребные винты не должны проворачиваться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 без предварительного согласования с представителем причала. Медленное проворачивание винтов у}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 турбоходов валоповоротным устройством допускается после проверки, что под кормой "чисто".}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.11. Необходимо постоянно поддерживать связь танкера с нефтебазой на берегу для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможности немедленного прекращения грузовых операций при условиях, которые могут привести}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 к разливу нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.12. Поднимаемая на борт танкера шланговая линия в зависимости от принятой технологии}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 может быть пустой, частично или полностью заполненной грузом, поэтому ее масса может резко}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 меняться. Перед подъемом шланговой линии необходимо еще раз удостовериться у представителя}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтебазы в том, что ее общая масса не превышает грузоподъемности судовой стрелы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.13. При проведении грузовых операций на рейде в темное время суток должно быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обеспечено освещение грузовой палубы согласно действующим нормам, а также поверхности моря в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 районе шлангоприемников, для того чтобы можно было своевременно обнаружить утечку или разлив}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.14. Во время производства грузовых операций необходимо производить контрольные замеры}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 количества груза одновременно на берегу и на судне. В случае обнаружения значительного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 расхождения следует на время прекратить грузовые операции и проверить, нет ли утечки груза в море}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 на трубопроводной линии.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.15. Капитан танкера при неблагоприятных погодных условиях может потребовать начать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погрузку до начала выгрузки балласта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Совмещение балластных и грузовых операций может быть осуществлено с письменного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разрешения грузоотправителя, если танкер оборудован для этого.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.16. Капитан танкера, прибывшего на рейд для выгрузки наливного груза, в случае плохих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погодных условий может потребовать начать прием балласта в освободившиеся грузовые танки до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 того, пока будет полностью закончена выгрузка. Эта операция может быть осуществлена с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 письменного разрешения грузополучателя.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В случае несогласия грузополучателя на производство балластировки в процессе выгрузки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 капитан должен приостановить выгрузку и принять меры по обеспечению безопасной стоянки судна}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или отхода от места выгрузки в море до улучшения погоды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.17. При малых глубинах следует следить за тем, чтобы грузовые шланги не попали между}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 днищем судна и морским дном, что может привести к разливу груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 8.18. Шланговая линия от берега до танкера заводится и крепится на танкере силами и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 средствами грузополучателя (грузоотправителя) и под его ответственность. Контроль за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 герметичностью трубопроводной и шланговой линии от приемных фланцев танкера до береговых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 резервуаров осуществляется грузополучателем (грузоотправителем), который несет ответственность}\par}{\pard \sl-353\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 за загрязнение моря в результате неисправности шланговой линии.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4335{\tab\f0\cf1\fs24 \b 9. Перегрузка с судна на судно}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.1. Техническое состояние лихтеров, танкеров, барж, бункеровщиков и буксиров, подходящих к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борту груженого и недегазированного танкера, должно отвечать требованиям Правил}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 противопожарной защиты судов Регистра СССР и Правил по предотвращению загрязнения моря с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судов (конструкция и оборудование) Регистра СССР.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.2. Все правила безопасности для танкера, производящего погрузку у причала, обязательны для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судов, осуществляющих перегрузку нефтегруза с судна на судно.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.3. Для успешного проведения операции по перегрузке, если работу предполагается выполнять}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вдали от порта, между капитанами этих судов должна быть осуществлена предварительная}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 договоренность относительно выбора района, где предполагается проведение грузовых операций,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 способа постановки на якорь или метода швартовки с учетом условий погоды и ее прогноза,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 волнения моря и силы приливных течений, глубин в районе маневрирования, характера грунта, а}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 также интенсивности движения других судов в данном районе. Капитаны должны внимательно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 следить за прогнозом погоды для данного района весь период проведения грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.4. Старшим при передаче груза с танкера на другие суда является капитан танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.5. Суда, приходящие на рейд для осуществления перегрузки нефтегрузов, должны становиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 на якорь на отведенном портом месте. Места для стоянки наливных судов должны отводиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 портом в стороне от обычного пути следования других судов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Суда, осуществляющие плавание вблизи мест рейдовой перегрузки нефтепродуктов, должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соблюдать особую осторожность.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.6. Во время перегрузочных операций, осуществляемых танкером и наливной баржей на рейде,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 порт должен выставлять в этом районе дежурный катер, оснащенный устройствами для водяного и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пенного тушения, для оказания в случае необходимости помощи этим судам.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При отсутствии пожарного катера должен выделяться буксир, оснащенный дополнительно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимыми средствами пожаротушения. Если грузовые операции осуществляются между}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкерами, дежурство пожарного катера необязательно.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.7. Необходимо заблаговременно наладить постоянную надежную радиосвязь между}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подходящими друг к другу судами для безопасной организации швартовных и перегрузочных работ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.8. Суда, лихтеры, баржи, имеющие разрешение Регистра СССР на подход к танкерам, во время}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проведения грузовых операций должны становиться так, чтобы дымовые и выхлопные трубы этих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судов не находились против грузовой палубы танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.9. При производстве перегрузочных операций на открытых рейдах необходимо учитывать, что}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ухудшение погоды в любое время может прервать грузовые операции и заставить суда штормовать.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Недопустима даже на короткое время неравномерная перекачка груза с созданием крена и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чрезмерного дифферента, ухудшающих мореходные качества наливной баржи и танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.10. Подход к борту танкера лихтера или наливной баржи с буксиром или других плавучих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 средств необходимо производить с особой осторожностью, чтобы избежать ударов, трений или}\par}{\pard \sl-173\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 навала на борт танкера, с обязательным применением мягких кранцев.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.11. Лихтер или наливная баржа должны быть пришвартованы растительными или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 синтетическими швартовными канатами и на случай срочного их отвода от танкера в месте}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 крепления канатов должны быть приготовлены топоры. На случай быстрого отвода наливной баржи}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 от борта танкера с его кормы на бак баржи должен быть подан стальной швартовный канат, который}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 после отдачи растительных и синтетических канатов выбирается лебедкой (шпилем) с кормы танкера,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и, таким образом, наливная баржа отводится за корму танкера и держится там до подхода к ней}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 буксира.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.12. Перекачку нефтегрузов с танкера на танкер или на наливную баржу, когда суда}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пришвартованы лагом, необходимо производить с соблюдением всех мер предосторожности,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рекомендуемых хорошей морской практикой. При значительном волнении моря слив или налив}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов должен быть прекращен, лихтер или наливная баржа должны быть отведены от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борта танкера и поставлены на якорь в отдалении.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Наливная баржа с грузом нефтепродуктов на борту днем и ночью несет те же сигналы, что и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкер.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.13. Интенсивность перекачки на лихтер или наливную баржу должна быть установлена с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 учетом диаметра и состояния грузовых шлангов, диаметра трубопровода наливной баржи, емкости}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков баржи.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.14. Лихтер или наливная баржа должны быть пришвартованы к танкеру только на время}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проведения грузовых операций. Как только они будут закончены, лихтер или наливная баржа}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны быть отведены. При работе в темное время суток грузовая палуба наливной баржи должна}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 освещаться прожекторами с танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Во время стоянки наливной баржи у борта главная машина танкера и все противопожарные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 средства должны находиться в готовности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.15. Слив легковоспламеняющихся (летучих) нефтепродуктов с танкера на наливную баржу на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ходу запрещается. Слив на ходу допускается только веществ средней воспламеняемости и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трудновоспламеняющихся, при условии, что волнение моря не препятствует этому.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.16. Слив легковоспламеняющихся (летучих) нефтепродуктов с танкера одновременно на две}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 стоящие у борта наливные баржи не допускается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.17. Буксировка лагом более одной баржи или танкера, груженных легковоспламеняющимися}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (летучими) нефтепродуктами, не допускается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.18. При производстве грузовых операций в открытом море для предотвращения ударов судов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 бортами необходимо применять крупногабаритные пневматические кранцы. Для уменьшения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможности выжимания кранцев на палубу одного из судов они должны находиться на воде между}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судами в районе их цилиндрической части в течение всего периода проведения грузовых работ. В}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 момент подхода судов друг к другу необходимо также подготовить вспомогательные переносные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 кранцы в районах носовых и кормовых подзоров.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.19. Капитанам судов необходимо заблаговременно ознакомить членов своих экипажей с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 планом предстоящих работ и разъяснить особенности швартовных операций в условиях открытого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моря. Особенности швартовки должны учитываться при инструктаже членов швартовных команд на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рабочих местах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.20. Перед началом швартовных операций капитан судна должен убедиться в том, что:}\par}{\pard \sl-353\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.20.1. Приборы управления судном, главная машина, рулевое управление и средства связи с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 другим судном находятся в исправном состоянии. Судно не должно иметь крена на тот борт,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 которым предстоит швартоваться. В противном случае в момент полхода судна могут быть нанесены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 повреждения себе или другому судну.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.20.2. Грузовые насосы, шланги, грузовые стрелы и снаряжение для работы с грузовыми}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шлангами полностью подготовлены к работе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.20.3. Подготовлено к немедленному действию противопожарное оборудование. Плотно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрыты пробки палубных шпигатов, подготовлены поддоны достаточной емкости под приемники}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шлангов и приняты другие возможные меры для предупреждения разлива нефти в море.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.20.4. Закрыты и обжаты все иллюминаторы и двери помещений, которые выходят на грузовую}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 палубу и на тот борт, которым судно собирается швартоваться. Палубные воздухоотборники}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 искусственной вентиляции жилых помещений и системы кондиционирования воздуха закрыты и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 система работает в замкнутом цикле, чтобы при проведении грузовых операций пары нефти не были}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 втянуты в судовые помещения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.21. Если судно оборудовано системой катодной защиты или оба судна оборудованы этими}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 системами, системы должны быть выключены до начала швартовных операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.22. В темное время суток палуба судна, к которому производится швартовка, должна быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 освещена и по возможности дано дополнительное освещение борта и выставленных кранцев.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.23. При подходе, отходе и во время совместной стоянки капитан швартующегося (отходящего)}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна обязан выполнять указания капитана танкера, к которому производится швартовка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (отшвартовка). Однако это не снимает ответственности с капитана подходящего (отходящего) судна.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Капитаны обоих швартующихся судов отвечают за безопасное проведение швартовки, отшвартовки и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.24. Если один из капитанов ошвартованных друг к другу судов считает, что стоянка (или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 движение) в ошвартованном положении опасна для обоих судов или для одного из них, то}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требования этого капитана в части отшвартовки либо принятия других мер, обеспечивающих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасность судов, должны быть выполнены.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.25. Если один из капитанов не согласен на производство швартовки из-за неблагоприятной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погоды, волнения моря, необеспечения швартовки надлежащими кранцами и швартовными канатами}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 либо по другим причинам, связанным с безопасностью судов и угрозой разлива груза, швартовка не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должна осуществляться.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.26. Когда швартовка закончена, курс и скорость судов взаимно согласовываются капитанами с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 целью снижения усилий на швартовные канаты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.27. При производстве грузовых операций на якоре или на ходу главные двигатели обоих судов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны находиться в постоянной готовности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.28. Во избежание обрыва бакштова и грузовых шлангов во время буксировки нельзя допускать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 резких поворотов или изменения скорости обоих судов, а также заходить в лед, который может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 повредить шланг. С ухудшением погоды грузовые операции следует прекратить и судам разойтись до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 улучшения погоды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.29. В штормовую погоду разворот на обратный курс на бакштове представляет значительную}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опасность и требует особого внимания капитанов обоих судов. Во всех случаях разворота судов на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обратный курс грузовые операции на это время должны быть приостановлены.}\par}{\pard \sl-353\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.30. Длина шлангов должна обеспечивать перепад по высоте бортов, который при передаче}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груза будет резко меняться. Соединения шлангов с приемниками должны быть надежными и быстро}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отдаваться.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.31. Перед подачей шлангов оба корпуса судов должны быть надежно заземлены между собой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 специальным кабелем (см. п. п. 7.4 и 7.5).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.32. При перекачке груза шланговые линии должны быть в нескольких местах подвешены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подъемными устройствами обоих судов, чтобы предотвратить их разрыв или перетирание.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.33. При работе в ночное время в целях немедленного обнаружения течи или разлива груза и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 своевременного их устранения в районе расположения шланговых линий должно быть обеспечено}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 хорошее освещение и постоянно выставлен вахтенный матрос.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.34. В случае обнаружения течи через грузовой трубопровод, шланг или фланцевое соединение}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перекачку груза немедленно прекратить, установить причину утечки и ликвидировать неисправность.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Разлитые на палубу нефтепродукты убрать, не допуская их вылива за борт.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.35. Во время передачи груза внимательно следить за швартовными канатами и кранцами.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Особое внимание обращать на возможное протирание и смещение со своих штатных мест}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пневматических кранцев. Чаще всего это происходит во время качки судов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.36. Если на борту подошедшего под погрузку танкера имеется балласт, то его можно сливать в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 море при условии, что он удовлетворяет всем требованиям чистого балласта и местные портовые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 правила разрешают его слив.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.37. Не рекомендуется одновременный слив в море чистого балласта, находящегося в грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танках, и прием нефтепродуктов в другие танки, если танкер не имеет оборудования для совмещения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 этих операций, чтобы не допустить загрязнения моря.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.38. Если по погодным условиям приходится после откачки части балласта принимать груз и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 затем опять переходить на выкачку балласта, то необходимо тщательно осушить трубопроводы от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 остатков нефтепродуктов, промыть их чистой водой в отстойные танки и только после этого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возобновить выкачку балласта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.39. Если на борту подошедшего под загрузку танкера находится грязный балласт и на нем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсутствует сепаратор балластных вод, отвечающий конвенционным требованиям, то рекомендуется}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сначала произвести частичную приемку груза в свободные танки, а в освободившиеся из-под груза}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танки другого танкера слить свой грязный балласт и только после этого закончить всю погрузку.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.40. При проведении грузовых операций в открытом море нельзя допускать неравномерного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 распределения груза по танкам и нарушения допустимых напряжений на корпус или создания}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 большого дифферента с потерей судном мореходных качеств даже на короткое время, так как в любой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 момент может ухудшиться погода и возникнет срочная необходимость прекратить грузовые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.41. В течение всего периода грузовых работ в условиях открытого моря у палубного поста}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 управления грузовыми насосами должен находиться донкерман или вахтенный для принятия}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 срочных мер, если это потребуется.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.42. По окончании грузовых операций судно с большим надводным бортом перекрывает}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приемный клинкет на шлангоприемнике и приотдает сверху фланец грузового шланга, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 находящиеся в нем остатки груза слились самотеком в грузовой танк низкосидящего судна. Затем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрывают все клинкеты на обоих судах, отсоединяют грузовые шланги и на их фланцы ставят}\par}{\pard \sl-353\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заглушки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.43. Если произошел разлив нефтепродуктов в море и они плавают у бортов стоящих лагом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судов, их необходимо работой гребного винта и струями воды из пожарных шлангов постараться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отогнать от борта, чтобы уменьшить пожарную опасность.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 О происшедшем разливе необходимо немедленно оповестить администрацию ближайшего}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 порта для принятия срочных мер по уборке плавающих на поверхности моря нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 9.44. При доставке топлива в районы рыболовного промысла шланги для его перекачки с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкера на рыбопромысловые суда предоставляют рыбопромысловые организации. Шланги должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть в хорошем техническом состоянии и иметь соответствующие сертификаты (см. п. п. 7.7, 7.8).}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Контроль за их состоянием и своевременная замена являются обязанностью рыбопромысловой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 организации, которая несет ответственность за возможное загрязнение моря нефтепродуктами,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 произошедшее в результате предоставления шлангов, не отвечающих предъявляемым к ним}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требованиям.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3240{\tab\f0\cf1\fs24 \b 10. Совмещение грузовых и балластных операций}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 10.1. Принимая решение о совмещении грузовых и балластных операций, капитан танкера}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должен быть полностью уверен в том, что судовые системы, предназначенные для этих операций, во}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 всех отношениях удовлетворяют требованиям по разделению танков и трубопроводов с балластом от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков и трубопроводов с нефтегрузом и находятся в хорошем техническом состоянии.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 10.2. При проведении совмещенных грузовых и балластных операций следует тщательно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соблюдать на всех этапах процесса полное и эффективное разделение грузовых и балластных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопроводов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При этом обязательным условием является наличие не менее двух закрытых клинкетов между}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 балластным и грузовым трубопроводами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 10.3. Сброс чистого балласта за борт во время погрузки нефтепродуктов допускается только}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 после официального разрешения капитана порта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 10.4. Прежде чем производить одновременно с приемом нефтегруза выкачку чистого балласта,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо известить администрацию порта о примерном времени начала слива чистого балласта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Особенно важное значение это приобретает в условиях, когда слив балласта производится за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борт в портовые воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 10.5. Прием балласта в танки из-под груза с одновременной выгрузкой нефтепродуктов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 допускается только после согласования этого вопроса с грузополучателем и возможен на танкере,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовая система которого обеспечивает выполнение такой операции без риска загрязнения моря.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 10.6. Если судно оборудовано танками изолированного балласта, то слив балласта из этих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков может производиться в любой точке Мирового океана и во всех портах с учетом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 национальных норм и правил. При этом изолированный балласт не должен содержать механических}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 примесей, для чего танки изолированного балласта должны содержаться в чистоте.}\par}{\pard \sl-983\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx4185{\tab\f0\cf1\fs24 \b 11. Плавание груженого танкера}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.1. Перед выходом в море необходимо проверить плотность закрытия крышек горловин}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков и бункерных отсеков, смотровых лючков, моечных горловин, пробок замерных трубок и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 других отверстий танков, а также всех клинкетов на грузовых, зачистных и бункеровочных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 магистралях. Проверить наличие на приемниках грузовых и бункеровочных трубопроводов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поставленных и обжатых заглушек.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.2. Проверить, включены ли в работу автоматические дыхательные клапаны "давление -}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вакуум" на газоотводной системе. В плавании в зимних условиях периодически проверять, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клапаны не примерзли к гнездам: примерзание может привести к повышению давления или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 образованию вакуума в грузовых танках до опасных пределов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.3. До выхода в море необходимо убрать с грузовой палубы все имущество и предметы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 снабжения, полученные в порту, которые в штормовую погоду могут нанести повреждения грузовому}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 оборудованию, в результате чего может произойти разлив груза и возникнуть пожар.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.4. Проверить герметичность корпуса танкера внешним осмотром надводного борта и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прилегающей водной поверхности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.5. Если предстоит длительный морской переход, необходимо обжать палубные сальники}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клинкетов грузовой магистрали, чтобы предотвратить выливание через них нефтепродуктов на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 палубу, а также возможность обводнения груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.6. В плавании необходимо периодически поджимать задрайки на горловинах танков,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моечных лючках, чтобы избежать обводнения груза, а также утечки нефтепродуктов в море.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.7. При включении в работу системы подогрева груза в пути следования при малых пустотах}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо внимательно наблюдать за уровнем груза в танках. Груз при расширении может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заполнить пустоты и образовавшимся давлением сорвать крышку горловины танка или начать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выливаться на палубу через газоотводную систему.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.8. При загорании сажи в дымовой трубе в пути следования изменить курс судна так, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 искры не падали на палубу, включить в работу систему орошения палубы и искрогаситель}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загоревшейся трубы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.9. При плавании с грузом, интенсивно выделяющим газы, вылетающие из дымовой трубы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 искры или грозовой электрический разряд могут воспламенить газовый факел на колонке}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 газоотводной системы. В этом случае необходимо перекрыть ручной дыхательный клапан}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 газоотводной системы - поступление газа в атмосферу прекратится и факел потухнет.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.10. На судне, груженном легковоспламеняющимися нефтепродуктами, в носовом и кормовом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 коффердамах периодически должна определяться концентрация паров углеводородов. В случае}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обнаружения этих паров в количествах, превышающих 3,0 мл/л или 0,2% объемных, коффердам}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 немедленно должен быть провентилирован или заполнен водой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.11. В тех случаях, когда перекачки груза во время рейса избежать невозможно, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выполнять следующие мероприятия:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 кингстоны, забортные отливные клапаны и секущие клинкеты между грузовым и балластным}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопроводами, между грузовым трубопроводом и кингстонной магистралью должны быть закрыты}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и обжаты;}\par}{\pard \sl-368\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 если для перекачки груза не используется палубный грузовой трубопровод, то приемо-отливные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 патрубки палубного грузового трубопровода должны быть заглушены, а клинкеты закрыты и обжаты;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вести постоянный контроль за уровнем груза во всех танках;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 перекачку нефтегруза следует начинать при пониженной производительности насоса. После}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверки правильности поступления груза производительность насоса может быть доведена до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 номинальной;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 при перекачке нефтегруза дыхательные клапаны на газоотводной системе должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открыты; если количество груза в танках определяется замером пустот, то должны быть также}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открыты и смотровые лючки;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 если перекачка груза производится одним насосом одновременно в несколько грузовых танков,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 то учитывать неравномерность заполнения их: в танках, расположенных ближе к грузовому насосу,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 уровень груза повышается быстрее;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 перед началом перекачки груза закрыть и обжать клинкеты на приемных патрубках грузового и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 зачистного трубопроводов в танках, которые не участвуют в перекачке груза;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 перекачка груза должна производиться под контролем помощника капитана, ответственного за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выполнение грузовых операций;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 для контроля за уровнем груза в танках при его перекачке должно быть привлечено необходимое}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 число членов экипажа.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 О всех перекачках груза, с какой целью они производились, о пустотах в грузовых танках до и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 после перекачки, какими насосами и по каким грузовым магистралям производилась перекачка,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо сделать запись в судовом журнале и журнале нефтяных операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.12. Если груженому танкеру предстоит плавание в ледовых условиях, то перед входом в лед}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 все отверстия и горловины в ахтерпике и форпике, двойном дне, топливных и балластных отсеках}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны быть надежно закрыты. Также должны быть закрыты водонепроницаемые двери и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 иллюминаторы кормовых помещений.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В случае ледового повреждения корпуса судна герметически закрытые отсеки могут сохранять}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 его плавучесть, предупредить или уменьшить разлив нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.13. При плавании груженого танкера во льдах рекомендуется иметь в грузовых танках}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 достаточный запас пустот, чтобы при возможном ледовом повреждении корпуса судна можно было}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груз (или часть груза) перекачать из поврежденного танка в другие грузовые или балластные танки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.14. На борту танкера рекомендуется иметь несколько шлангов и погружной насос}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывобезопасного исполнения на случай срочной перекачки части груза из одних танков в другие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или на другое судно в случае получения ледового повреждения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.15. Перед входом в лед рекомендуется бункерное топливо из носовых отсеков, которые чаще}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 получают повреждения во льдах, перекачать в отсеки, расположенные в средней или кормовой части}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.16. Перед предстоящим плаванием во льдах рекомендуется разработать аварийный план, в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 котором указать, из каких танков, сколько и каким способом можно быстро откачать груз в случае}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 получения повреждения судна и уберечь его от возможного затопления или большого разлива}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов.}\par}{\pard \sl-533\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.17. Вход танкера в лед и продвижение во льду допускаются только с разрешения капитана}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 того порта, к которому следует судно, или начальника ледокольными операциями.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.18. При отсутствии условий, обеспечивающих безопасное плавание, вход груженого танкера}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в лед (особенно в штормовую погоду) запрещается, о чем капитан танкера оповещает капитана порта}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или начальника ледовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.19. Скорость следования во льдах должна быть сообразована с прочностью корпуса судна и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 состоянием льда с тем, чтобы избежать нарушения герметичности корпуса и возможности в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 результате этого утечки нефтепродуктов за борт.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.20. При плавании во льдах в случае неизбежного столкновения с крупной льдиной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо ставить танкер в положение, при котором удар льдины был бы принят прочным}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 форштевнем, а не той частью корпуса, где расположены грузовые и топливные отсеки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.21. Танкеру, следующему во льдах, необходимо избегать крутых поворотов, при которых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 можно получить опасные удары о выступающие углы льдин той частью корпуса, где расположены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсеки с нефтепродуктами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.22. Все время плавания во льдах необходимо держать в готовности грузовые и зачистные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 насосы и насосы для перекачки бункерного топлива, а также водоотливные средства и аварийно-}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 спасательное имущество на случай повреждения корпуса и необходимости быстрой ликвидации течи}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов за борт и откачки поступающей воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.23. При продвижении танкера во льдах необходимо постоянно вести наблюдение за уровнем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груза и бункерного топлива в танках. Вытекание нефтепродуктов можно обнаружить по следам}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефти, появляющимся на поверхности воды у борта судна и в кильватерной струе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.24. При первых признаках сжатия льда необходимо принять все меры, чтобы танкер не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 остался среди сплошных полей тяжелого льда или крупных льдин, где его корпус может быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 продавлен легче, чем при нахождении среди массы мелкобитого льда.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 11.25. При плавании танкера, груженного интенсивно испаряющимся грузом в районах с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 высокой температурой забортной воды и воздуха, для исключения больших потерь груза от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 испарения необходимо применять систему орошения грузовой палубы.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4050{\tab\f0\cf1\fs24 \b 12. Подготовка танкера к разгрузке}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 12.1. Перед приходом в порт выгрузки капитан танкера сообщает наименование, количество}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груза, дифферент, осадку судна, а также об особых мерах предосторожности, если таковые требуются}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 при разгрузке.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 12.2. Перед приходом в порт выгрузки необходимо проверить дистанционное управление}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовыми и зачистными клинкетами, устройство для дистанционного замера уровня груза,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 готовность и техническое состояние устройств и механизмов к шланговке. Обнаруженные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 неисправности устранить.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 12.3. К приходу в порт привести грузовые и зачистные насосы в хорошее техническое}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 состояние. Устранить течь в сальниках. Отрегулировать клапаны, чтобы исключить появление}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чрезмерной вибрации грузовых шлангов, которая может привести к их повреждению и разливу груза,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 а также устранить обнаруженные недостатки.}\par}{\pard \sl-83\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-938\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 12.4. Предохранительные клапаны на грузовых и зачистных насосах следует проверить и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отрегулировать на давление, превышающее на 0,1 МПа (1 кгс/кв. см) договорное давление, при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 условии, что оно не будет превышать максимальное рабочее давление для этой грузовой магистрали.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 12.5. Все клинкеты на грузовых и зачистных трубопроводах, расположенных на грузовой палубе,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 особенно клинкеты у шлангоприемников, включая кормовую магистраль, должны быть проверены и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 плотно закрыты, чтобы избежать разлива груза в начале выгрузки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 12.6. Если к приходу в порт выгрузки танкер осуществляет подогрев груза, то при всех условиях}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 температура в грузовых танках должна быть не менее чем на 5 град. C ниже его температуры}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вспышки, обозначенной в паспорте качества.}\par}{\pard \sl-818\par}{\pard \sl-0\tx5265{\tab\f0\cf1\fs24 \b 13. Выгрузка}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.1. Все правила для танкера, производящего погрузку у причала, обязательны для танкера,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 осуществляющего выгрузку.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.2. С приходом танкера в порт выгрузки на основании обмена информацией между судном и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузополучателем разрабатывается план разгрузки, содержащий указания об интенсивности}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разгрузки, максимально допустимом давлении в грузовых шлангах и стендерах, средствах связи, а}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 также о работе камбуза, режиме курения и других вопросах, связанных с безопасным проведением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.3. Разгрузка танкера должна производиться по заранее разработанной технологической карте.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 На всем протяжении выгрузки напряжения на корпус судна от распределения груза по танкам не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны превышать допустимых норм.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.4. Перед тем как открывать крышки смотровых лючков для отбора проб груза и замера пустот}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в грузовых танках, необходимо открыть ручкой клапан газоотводной системы, иначе давлением газов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в танке может сорвать крышку, привести к травме работающих и искрообразованию.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.5. После того как стендеры или грузовые шланги подсоединены к приемникам танкера и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 представитель грузополучателя сообщил о готовности берега к приему груза, следует начинать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выгрузку, для чего первыми открывают клинкеты на причале, и только после этого можно открывать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приемные клинкеты танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.6. Если до начала выгрузки береговой грузовой трубопровод находится под большим}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 давлением и на нем не установлен невозвратный клапан, то, чтобы исключить возможность}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поступления груза с берега в танки, что может привести к их переполнению и переливу груза,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо сначала запустить грузовой насос и только после этого постепенно открыть приемный}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клинкет у шлангоприемника на танкере.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.7. Выгрузку следует начинать малой интенсивностью, скорость потока не должна превышать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 1 м/с. При открытых клинкетах на грузовой магистрали необходимо произвести осмотр фланцевых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соединений грузовых шлангов на предмет отсутствия течи нефтегруза, а также удостовериться, что в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шлангах и трубопроводах давление не поднимается выше допустимого.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Увеличить выгрузку до номинальной можно только после получения разрешения с берега.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.8. Максимальная скорость потока нефтегрузов в грузовом трубопроводе на протяжении всей}\par}{\pard \sl-188\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выгрузки не должна превышать допустимую проектом судна (ГОСТ 5.5452-80) и берегового}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопровода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.9. После увеличения интенсивности выгрузки до максимальной следует постоянно вести}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 контроль за давлением в грузовой магистрали, чтобы оно не превышало допустимого; также следует}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вести наблюдение за фланцевыми соединениями грузовых шлангов и стендеров для своевременного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обнаружения течи.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.10. На протяжении всей выгрузки, особенно в первый момент, необходимо вести}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 наблюдение за водой вокруг танкера, особенно за тем районом, где расположены кингстоны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 насосного отделения и сливные забортные клапаны, с целью своевременного обнаружения малейших}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможных признаков утечки нефтегруза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.11. В начале выгрузки произвести осмотр насосного отделения, чтобы убедиться, что крышки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 фильтров, сальники клинкетов, пробки осушения грузовой системы не имеют течи нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.12. Во время работы грузовых и зачистных насосов необходимо вести наблюдение за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсутствием течи груза через сальники и подшипники и за их нагревом. Если произошел перегрев}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сальников, то насосы должны быть немедленно остановлены.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.13. Судно должно быть готово к прекращению слива груза в любой момент по получении}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующего сигнала с берега.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.14. С уменьшением осадки судна швартовные тросы необходимо своевременно потравливать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 на протяжении всей выгрузки, чтобы предупредить их разрыв и чрезмерную подвижку танкера, что}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 может привести к разрыву грузового шланга или повреждению стендера и разливу груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.15. В случае значительного ухудшения погоды, создающего чрезмерное движение судна у}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 причала, что может привести к разрыву грузового шланга или повреждению стендера, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прекратить выгрузку.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При этом необходимо учитывать, имеют ли грузовые стендеры устройство по их}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 автоматическому отключению от судовых приемников и автоматическому перекрытию потока груза}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 при неожиданном перемещении танкера сверх рабочей зоны стендера (см. Приложение 12).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.16. Палубные шпигаты при выгрузке должны быть так же плотно закрыты, как и при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погрузке.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.17. При выгрузке легковоспламеняющихся (летучих) нефтепродуктов, когда в танке остается}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мало груза и насос начинает работать без подпора на всасывании, струя груза разрывается и рабочие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 полости насоса заполняются газами. В этих случаях, если не принять надлежащих мер, насос может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перегреться и создать большую пожарную опасность. Первыми признаками разрыва всасываемой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 струи груза являются самопроизвольное повышение оборотов насоса и падение давления в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нагнетательной трубе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.18. При обнаружении разрыва всасываемой струи груза необходимо принять следующие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 меры:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 закачать насос грузом из полного танка;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 работать насосом при уменьшенных оборотах;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 давление в нагнетательной трубе держать не выше 0,2 - 0,3 МПа (2 - 3 кгс/кв. см);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 использовать инертный газ для создания давления в разгружаемом танке там, где он может быть}\par}{\pard \sl-323\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 применен.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.19. Запрещается прокачивать водой грузовые шланги и береговые трубы, особенно при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отрицательной температуре наружного воздуха. Прокачка водой грузовых шлангов и береговых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопроводов может производиться только при наличии соответствующего условия в договоре}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перевозки (чартере) и письменной заявки грузополучателя.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.20. В конце выгрузки, когда идет зачистка грузовых танков, при большом противодавлении в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 береговом трубопроводе возможно образование обратного потока груза с берега на судно. Если на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 береговом трубопроводе отсутствует невозвратный клапан, то необходимо частично перекрыть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приемный клинкет на танкере и держать его в таком состоянии до окончания всей зачистки грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков, после чего плотно закрыть.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.21. Если зачистка груза из всех танков производится в один из грузовых танков, то}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо вести постоянный контроль за уровнем груза в этом танке во избежание перелива.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 13.22. Если в процессе слива груза намечено производить мойку танков сырой нефтью, то об}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 этом должен быть проинформирован грузополучатель. Мойку танков грузом можно начинать после}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 получения согласия грузополучателя и портовой администрации.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При мойке танков грузом необходимо руководствоваться специальной инструкцией.}\par}{\pard \sl-818\par}{\pard \sl-0\tx2835{\tab\f0\cf1\fs24 \b 14. Перевозка нефтепродуктов повышенной токсичности}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.1. Перевозка этилированных и других нефтепродуктов повышенной токсичности разрешается}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 только на танкерах, предназначенных для перевозки легковоспламеняющихся (летучих)}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, конструкция которых отвечает требованиям безопасности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.2. Нефтепродукты, которые выделяют высокотоксичные пары, рекомендуется перевозить в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танках, оборудованных закрытыми системами замера уровня груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.3. Танкеры, предназначенные для перевозки нефтепродуктов повышенной токсичности, не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны иметь протечек ни в корпусе, ни в грузовой системе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Перед погрузкой необходимо проверить все фланцевые соединения, сальники клинкетов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовой и зачистной систем.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Грузовые и зачистные насосы необходимо подвергнуть тщательному осмотру и если}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 потребуется, то и ремонту, чтобы ликвидировать пропуски в сальниках, клапанах, фланцах,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подшипниках.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.4. Вентиляционные дефлекторы машинно-котельного отделения, жилых и служебных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помещений во время грузовых операций с нефтепродуктами повышенной токсичности, а также во}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 время рейса должны устанавливаться так, чтобы была исключена возможность попадания ядовитых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 паров в жилые и служебные помещения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.5. Во время проведения грузовых и балластных операций предупредительные надписи о}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 потенциальной опасности груза должны быть установлены на палубе и у входа в насосное}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отделение.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.6. При перевозке нефтепродуктов повышенной токсичности все двери и иллюминаторы,}\par}{\pard \sl-263\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выходящие на грузовую палубу, через которые токсичные пары могут проникнуть в помещения,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны быть закрыты не только во время проведения грузовых операций, но и во время морского}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перехода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.7. На борту судна должны находиться средства оказания первой помощи, кислородные и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дыхательные аппараты, противоядия к перевозимым токсичным грузам.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.8. На судне на каждого члена экипажа должен быть фильтрующий противогаз. Кроме этого,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должно быть не менее шести полных комплектов защитного снаряжения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.9. В полный комплект защитного снаряжения должны входить:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 дыхательный аппарат - шланговый или изолирующий - с воздушными баллонами,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 гарантирующий безопасность единовременной работы в помещении, заполненном вредными газами,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в течение не менее 20 мин.;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 защитная одежда, обувь, перчатки и плотно прилегающие очки;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 предохранительный пояс с наплечными лямками, со страховым канатом;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 взрывозащищенный фонарь;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 защитная маска.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Защитное снаряжение должно обеспечивать в аварийных или экстремальных случаях}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасную работу человека в загазованном помещении или районе судна в продолжение не менее}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чем 20 мин.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.10. Спецодежда и спецобувь, выдаваемые вахтенным, должны храниться в специальных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 металлических ящиках, установленных на открытой палубе. Хранить такую спецодежду в каютах}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.11. Все члены экипажа должны быть обучены и натренированы применению защитного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 снаряжения в случае аварии соответственно выполняемым обязанностям.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.12. Запрещается принимать на борт нефтепродукты повышенной токсичности до получения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 от грузоотправителя достаточных сведений, необходимых для безопасного проведения грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операций и перевозки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 О начале грузовых операций необходимо объявить по радиотрансляции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.13. Экипаж танкера, на котором предстоит перевозить нефтепродукты повышенной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токсичности, должен быть заблаговременно проинструктирован по вопросам техники безопасности}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и санитарной профилактики.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.14. Перед погрузкой необходимо провести проверку знания членами экипажа характерных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 особенностей данного груза и провести учебную тренировку для отработки методов борьбы в случае}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 утечки, перелива и возгорания груза с использованием защитного снаряжения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.15. Люди, работающие с нефтепродуктами повышенной токсичности, должны не реже 1 раза}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в 6 мес. подвергаться медицинскому осмотру.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.16. Допуск посторонних лиц на танкер во время проведения грузовых операций с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктами повышенной токсичности запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.17. Хождение по судну разрешается только по переходным мостикам и специально}\par}{\pard \sl-293\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отведенным местам.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.18. Налив и слив нефтепродуктов повышенной токсичности в портах и на рейде должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 производиться только закрытым способом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.19. Весь период погрузки все танковые отверстия, включая смотровые лючки и замерные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубки, должны быть закрыты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.20. Пары токсичных нефтепродуктов, вытесняемые грузом из грузовых танков, должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выпускаться по газоотводной системе. Смотровые лючки и замерные трубки могут открываться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 только на короткое время, необходимое для замера пустот и отбора проб.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.21. Уровень нефтепродуктов в танках во время проведения грузовых операций необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 замерять футштоком, который не впитывает нефтепродукты. При отборе проб из танков необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 избегать разлива нефтепродуктов на палубу.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.22. Чтобы избежать вдыхания вредных паров при замере пустот и отборе проб груза,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вахтенный должен стоять под прямым углом к направлению ветра и сбоку от замерных отверстий.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.23. При большой загазованности палубы необходимо уменьшить производительность}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погрузки, а если это не даст результата, то погрузка должна быть на время приостановлена, пока}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 скопившиеся газы не рассеются.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.24. Работать с нефтепродуктами повышенной токсичности разрешается только в резиновых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или полихлорвиниловых перчатках, в спецодежде и спецобуви, не пропускающих токсичные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 продукты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.25. Следует избегать погрузки через насосное отделение, для того чтобы предотвратить его}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загазованность вредными парами токсичных продуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.26. Во время проведения грузовых и балластных операций льяла насосного отделения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны содержаться сухими.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.27. Нельзя производить разборку и ремонт механизмов и устройств, не очищенных от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов повышенной токсичности, за исключением аварийных случаев, не терпящих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отлагательства.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.28. Вход в насосное отделение разрешается только в защитной одежде, в изолирующем или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шланговом дыхательном аппарате, с использованием спасательного пояса со страховым канатом. У}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 входа в насосное отделение должен находиться вахтенный и наблюдать за работающим в насосном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отделении. За 20 мин. до входа в насосное отделение должна быть включена вентиляция.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.29. По окончании грузовых операций разъединять шланги следует так, чтобы токсичные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродукты не пролились на палубу. Для этого в месте разъединения шлангов необходимо иметь}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующих размеров поддоны.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Если же произошел разлив, необходимо на это место посыпать опилки, собрать их в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 металлическую тару и затем сжечь в специальной печи или сдать на берег.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.30. Палубу танкера, переборки надстроек и все предметы, включая защитные приспособления}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и одежду, загрязненные нефтепродуктами повышенной токсичности во время погрузки и выгрузки,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо вымыть и обезвредить.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.31. Пробы груза должны храниться в герметически закупоренной и снабженной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующим ярлыком посуде, в плотно закрытых ящиках, в хорошо вентилируемом помещении,}\par}{\pard \sl-323\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрытом на ключ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.32. При перевозке летучих нефтепродуктов повышенной токсичности во избежание большого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 испарения груза от нагревания палубы в летнее время ее необходимо орошать забортной водой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.33. Жилые и служебные помещения танкера, перевозящего нефтепродукты повышенной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токсичности, во время морского перехода должны усиленно вентилироваться.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.34. Судовые работы, связанные с опасностью вдыхания токсичных паров груза, должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 производиться с наветренной стороны.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.35. Перед переводом танкера на перевозку обычных нефтепродуктов или перед постановкой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна в ремонт должны производиться полная и тщательная мойка и дегазация грузовых помещений}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и насосного отделения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.36. Если после перевозки нефтепродуктов повышенной токсичности будут погружены}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обычные нефтепродукты без предварительной зачистки и мойки танков, то режим на судне должен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть такой же, как и при перевозке токсичных нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.37. Попавшие на кожу этилированные и другие нефтепродукты повышенной токсичности}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 надо тотчас же снять ветошью, смоченной керосином или другим рекомендованным растворителем,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 стараясь не втирать его в кожу, а затем вымыть пораженное место горячей водой с мылом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.38. Вахтенный помощник капитана и вахтенные матросы, осуществляющие грузовые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операции, должны усилить наблюдение за работающими на палубе с целью своевременного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обнаружения первых признаков отравления.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.39. Нельзя есть, пить и курить в помещении, где разлиты нефтепродукты повышенной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токсичности или скопились их пары.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 14.40. Все члены экипажа, работающие с нефтепродуктами повышенной токсичности, должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 после вахты принимать горячий душ.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3915{\tab\f0\cf1\fs24 \b 15. Перевозка нефтепродуктов в таре}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.1. На танкерах, груженных легковоспламеняющимися (летучими) нефтепродуктами, перевозка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 какого-либо груза на грузовой палубе запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.2. Погрузка и выгрузка тарного груза во время налива и слива нефтепродуктов, мойки и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дегазации танков, а также во время приема балласта запрещаются.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.3. Погрузочно-разгрузочные операции и перевозка нефтепродуктов в таре должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 производиться только в соответствии с Правилами МОПОГ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.4. Легковоспламеняющиеся (летучие) нефтепродукты в таре должны подвозиться к борту}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкера на транспортных средствах, приспособленных для этого, и вывозиться из порта немедленно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 по выгрузке их с танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.5. Капитан танкера, принимающий к перевозке нефтепродукты в таре, в случае сомнений}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 может потребовать проверки (отбора проб) правильности сделанного грузоотправителем сообщения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 о грузе.}\par}{\pard \sl-353\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.16. На танкерах, перевозящих горючие (нелетучие) нефтепродукты, при наличии деревянного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 настила допускается перевозка на палубе нефтепродуктов с температурой вспышки паров выше 60}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 град. C в следующей таре:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 железных бочках с герметической укупоркой;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 жестяных бидонах с герметическими крышками или пробками, заключенных в деревянные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клетки;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 специальных наливных контейнерах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Каждое место должно иметь четкую маркировку с наименованием груза. Груз с нарушенной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тарой к отгрузке не должен приниматься.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.7. На танкерах запрещается хранение и перевозка каких бы то ни было взрывчатых и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отравляющих веществ. Допускается исключение только при условии наличия на судне специально}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 оборудованного помещения согласно нормам Регистра СССР.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.8. Разлив нефтепродуктов из бочек в бидоны или другую тару на танкере не разрешается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.9. Все предъявленные к перевозке морем нефтепродукты должны быть налиты в бочки или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 бидоны не более чем на 95% их вместимости во избежание повреждения тары от теплового}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 расширения жидкости.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 До начала погрузки нефтепродуктов в таре все лючки, крышки танков, пробки замерных трубок}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и другие палубные отверстия должны быть закрыты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.10. Когда бочки или контейнеры грузят на палубу, они должны быть уложены следующим}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 образом:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вдали от жилых помещений;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 только в один ряд;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 пробки бочек обращены вверх;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 не загромождать подходы к палубной арматуре, включая посты управления клинкетами от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 палубных трубопроводов, моечным танковым лючкам, трапам и пожарным магистралям;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 надежно отсепарированы и закреплены.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.11. Нельзя перевозить легковоспламеняющиеся (летучие) сорта нефтепродуктов в таре в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 носовых помещениях и помещениях средней надстройки, если эти помещения не предназначены для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 этих целей. Погрузка нефтепродуктов в таре в сухогрузный трюм производится с учетом требований}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 МОПОГ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.12. На танкерах, оборудованных для перевозки легковоспламеняющихся (летучих)}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, допускается погрузка в сухогрузный трюм нефтепродуктов в таре всех сортов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.13. В сухогрузный трюм танкера, предназначенного для перевозки горючих (нелетучих)}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, могут быть погружены только горючие (нелетучие) нефтепродукты в таре.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.14. Нефтепродукты в таре разрешается перевозить в трюме, который оборудован освещением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и вентиляцией во взрывобезопасном исполнении.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.15. Во время проведения грузовых операций в трюме клапаны системы объемного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожарного тушения должны быть закрыты и приняты меры от их случайного открытия. Вся арматура}\par}{\pard \sl-83\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 систем пожаротушения, и в частности головки объемного тушения, должна быть защищена от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможных механических повреждений.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.16. До начала грузовых работ вблизи сухогрузного трюма должны быть приготовлены два}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пенных огнетушителя, кошма, а также пенный и водяной стволы. Паротушение также должно быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приготовлено к действию.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.17. Перед началом грузовых работ трюм должен быть хорошо провентилирован и проверен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 состав его воздуха газоанализатором. Только после этого в трюм разрешается спускаться людям и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 начинать работу.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.18. Трюм должен вентилироваться все время, пока производятся грузовые операции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Если грузовые операции были на время прерваны и трюм был закрыт, необходимо перед}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возобновлением работ произвести тщательную вентиляцию и проверку воздуха газоанализатором}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (Приложение 6).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.19. Перед началом грузовых операций комингсы сухогрузного трюма и трюмный трап}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо обшить досками или завесить брезентом, чтобы исключить возможность образования}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 искры при ударе подъемом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.20. Погрузка нефтепродуктов в таре в трюм или их выгрузка должна производиться под}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 непосредственным наблюдением вахтенного помощника капитана или лица, его заменяющего.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.21. Грузовые операции необходимо производить с соблюдением мер предосторожности, не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 допуская ударов бочек о комингсы трюма и борт судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.22. Сепарационные доски, деревянные клетки, которые грузят в сухогрузный трюм вместе с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктами в таре, должны быть сухими. По этой же причине грузовые работы с грузом в таре}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 не должны производиться во время дождя и снегопада.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.23. В трюме рядом с нефтепродуктами в таре нельзя складировать материалы, обладающие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 свойством самовозгораться, если они будут пропитаны нефтепродуктами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.24. Тару грузов следует осматривать на берегу, и дефектные грузовые места не должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приниматься к погрузке в трюм.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.25. Во время погрузки бочки с легковоспламеняющимися (летучими) нефтепродуктами}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны спускаться на покрытый сепарацией настил второго дна трюма.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.26. Бочки не следует волочить по палубе или по настилу второго дна трюма и допускать их}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 скольжения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.27. Для предотвращения возможных повреждений груза в рейсе должно быть использовано}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 достаточное количество хорошей сепарации и груз в таре должен быть хорошо закреплен.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.28. Каждый ряд нефтепродуктов в таре должен отделяться сепарацией. Количество}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 допустимых рядов груза по высоте должно быть указано грузоотправителем.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.29. Недегазированная тара после слива нефтепродуктов представляет повышенную}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожарную опасность, и при согласии капитана на ее погрузку должны строго соблюдаться меры}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предосторожности. Отверстия порожних контейнеров и бочек перед погрузкой должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрыты должным образом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.30. После окончания грузовых операций трюм перед закрытием должен осматриваться на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предмет отсутствия людей.}\par}{\pard \sl-113\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-908\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.31. Погрузка нефтепродуктов в таре в трюм должна производиться только в светлое время}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 суток.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.32. Баржа, груженная легковоспламеняющимися (летучими) нефтепродуктами в таре, не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должна оставаться у борта танкера в темное время суток.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.33. В плавании на протяжении всего рейса необходимо осуществлять должный контроль за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 состоянием груза, его тарой, температурой и загазованностью трюма.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.34. Во время рейса необходимо вести постоянный контроль за палубным грузом. При}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обнаружении повреждения тары во избежание попадания груза за борт палубные шпигаты должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть закрыты и приняты меры по уборке разлитого груза в отстойный танк, после чего шпигаты}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 следует открыть.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 15.35. Перед началом выгрузки груза в таре трюм необходимо предварительно осмотреть и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверить на содержание паров углеводородов. Если при осмотре будет обнаружено, что часть груза}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разлита, прежде чем начинать выгрузку, разлитый груз необходимо откачать в отстойный танк, трюм}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дегазировать. Работы следует производить в защитной одежде, в изолирующем или шланговом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 противогазе.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3915{\tab\f0\cf1\fs24 \b 16. Проведение балластных операций}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.1. Расположение и количество балласта, принимаемого на судно, должны обеспечивать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 остойчивость судна и прочность корпуса, отсутствие чрезмерной вибрации, хорошие мореходные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 качества и оптимальную скорость на морском переходе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.2. До начала приема балласта ответственное лицо, назначенное капитаном, руководствуясь}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 его указаниями, информацией о загрузке и остойчивости судна, заводской инструкцией на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проведение балластных операций, составляет план балластировки, который утверждает капитан}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.3. Любая операция на борту танкера, связанная с приемом, сливом или перекачкой балласта,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выполняется под непосредственным руководством специального назначенного капитаном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ответственного лица.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.4. Лицо, выполняющее операции с балластом, должно быть обеспечено полной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 информацией о порядке выполнения работ, знать правила и законы, включая местные, касающиеся}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предотвращения и ликвидации загрязнения моря нефтью, иметь достаточный опыт и знания по}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 применению для этих целей оборудования и устройств судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.5. Если балласт принимается в танки, в которых имеются остатки груза, или в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 недегазированные танки, то должны выполняться все меры предосторожности, как при выполнении}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых операций с нефтепродуктами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.6. Для того чтобы меньше остатков груза попало в принимаемый балласт, необходимо до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 начала его приема спустить остатки из палубных и днищевых трубопроводов и из стояков в один из}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 кормовых танков и затем эти собранные остатки откачать в один из отстойных танков. Все насосы,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопроводы, фильтры, которые предполагается использовать для приема балласта, должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предварительно промыты забортной водой, а образовавшиеся смывки собраны в отстойном танке.}\par}{\pard \sl-428\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.7. До начала приема балласта необходимо тщательно отсечь клинкетами те участки грузового}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопровода, которые не будут участвовать в приеме балласта, чтобы избежать их загрязнения. В}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дальнейшем эти клинкеты не должны открываться до окончания слива балласта из других танков.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Кроме этого, необходимо поставить заглушки на все приемники палубных трубопроводов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.8. Ответственный за проведение балластных операций должен известить представителя}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 порта о приблизительном времени начала и продолжительности приема балласта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.9. До начала приема балласта в недегазированные танки при стоянке судна у причала}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ответственный за проведение балластных операций должен проконсультироваться с представителем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 берега и проверить выполнение всех мер безопасности, как при погрузке летучих нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.10. Загрязнение портовых вод часто происходит в тот момент, когда для приема балласта}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открывается днищевой кингстон в насосном отделении. В момент открытия кингстона из-за малой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 осадки танкера нефтепродукты, оставшиеся в трубопроводе, выливаются за борт через кингстоны.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Чтобы этого не произошло, необходимо сначала включить в работу грузовой насос, предназначенный}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 для приема балласта, и только после этого открыть кингстон. Создавшийся при этом небольшой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вакуум в грузовом трубопроводе не даст возможности остаткам груза вытечь за борт.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.11. Если предполагается прием балласта самотеком, необходимо сначала включить в работу}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовой насос и только после этого открыть кингстон. Только после того, как грузовой насос}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проработает 10 мин. на промывке грузовой магистрали, можно переходить на прием балласта}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 самотеком.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.12. Прием балласта, так же как и груза, следует начинать медленно и только после того, как у}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помощника капитана, принимающего балласт, появится уверенность в том, что балласт начал}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поступать в предназначенные для этого танки, можно увеличить норму приема балласта до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 номинальной.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.13. Прием балласта в танки следует производить с той же осторожностью, что и прием}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтегруза, так как перелившаяся из танка балластная вода вместе с остатками груза создает}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожарную опасность и может явиться причиной загрязнения морских вод нефтепродуктами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.14. О времени окончания приема балласта помощнику капитана, ответственному за прием}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 балласта, необходимо заблаговременно предупредить персонал, обслуживающий грузовые насосы,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чтобы во избежание перелива грязного балласта за борт он мог без промедления остановить насосы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.15. Балласт нельзя принимать через горловины в танки, которые имеют остатки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, так как при падении с большой высоты струя воды, попадая на остатки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, создаст в грузовом танке статическое электричество опасной концентрации.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Если необходимо принять в танки балласт не по грузовой магистрали, а "через верх", то шланг}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должен быть опущен до самого днища.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.16. Остатки нефтегруза в танках, заполненных водяным балластом, могут создать в них}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывоопасные концентрации паров нефтепродуктов. По этой причине во время балластных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 переходов не допускается производство каких-либо работ или оббивка ржавчины в районе}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 недегазированных танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.17. Если во время балластного перехода в недегазированном танке замечен обрыв какой-либо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 металлической детали (трапа, кронштейна и др.) и это повреждение невозможно сразу устранить, то}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 этот танк необходимо заполнить балластом, чтобы исключить возможность образования искры от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ударов оборвавшейся детали. Обрыв детали необходимо устранить при первой возможности.}\par}{\pard \sl-563\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.18. Капитан танкера должен располагать достоверной информацией о портах, в которых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможен слив грязного балласта на береговые и плавучие очистные сооружения, а также об}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 условиях, на которых осуществляется слив, чтобы не допускать случаев неоправданного слива в море}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грязного балласта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.19. Перед прибытием танкера в порт погрузки необходимо сообщить о количестве грязного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 балласта, предназначенного для слива в портовые емкости, а также виде груза, который перевозился}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в последний раз. До прихода танкера порт должен подтвердить возможность приема всего балласта в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 свои емкости.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.20. Подготовка танкера к сливу и слив грязного балласта в береговые очистные сооружения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 производятся в соответствии с теми же правилами и предписаниями по безопасности и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предотвращению загрязнения моря, которые действуют во время слива нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.21. Сброс грязного балласта с танкера в портовые и прибрежные воды, а также в особых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 районах запрещается. Сброс грязного балласта в открытом море разрешается только при условии}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выполнения всех требований действующей Международной конвенции по предотвращению}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загрязнения моря нефтью 1954 г., а также требований Наставления по предотвращению загрязнения с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судов РД 31.04.03-79 и других руководящих документов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.22. Чистый балласт принимается на нефтяной танкер в тех случаях, когда:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 в порту погрузки отсутствуют береговые сооружения для приема грязного балласта и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разрешается слив чистого балласта в портовые воды;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 намечаются балластные операции в период плавания танкера в особых районах или в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прибрежных водах;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 танкер следует в ремонт или на докование;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 прием чистого балласта обусловлен производственной необходимостью или правилами}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подготовки танкера к очередной перевозке груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.23. Следуя в порт погрузки, капитан танкера должен располагать информацией об условиях}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 слива чистого балласта в данном порту и в соответствии с этим планировать свои действия.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.24. Прием чистого балласта должен производиться по чистым от нефти трубопроводам,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чистыми насосами, в чистые грузовые танки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.25. Лицо, ответственное за прием чистого балласта, должно иметь полную уверенность в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чистоте линии грузовой системы, по которой будет производиться прием чистого балласта, затем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 лично убедиться в отсутствии нефтепродуктов в танках с чистым балластом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.26. Если предполагается слив чистого балласта за борт в порту прихода, то в этом случае}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обязательна предварительная тщательная промывка чистым балластом кингстона и подходящего к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нему участка трубопровода до прихода танкера в порт.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.27. Сброс чистого балласта в портовые воды может производиться только после}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предварительного согласования этого вопроса с администрацией порта и ознакомления с портовыми}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 правилами и правительственными постановлениями по поводу сброса водяного балласта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.27.1. Во внутренних морских водах СССР, на акваториях портов, в районах санитарной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 охраны и в районах, имеющих рыбохозяйственное значение, слив любых нефтесодержащих смесей, а}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 также чистого балласта за борт запрещается. Чистый водяной балласт, а также все образующиеся на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкере смеси, содержащие перевозившуюся в качестве груза нефть, необходимо сдавать на}\par}{\pard \sl-233\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приемные сооружения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.28. Перед началом сброса чистого балласта необходимо убедиться в отсутствии в танке с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чистым балластом каких-либо следов нефти.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.29. На все время сброса чистого балласта за борт необходимо установить наблюдение за его}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выходящим потоком.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.30. При появлении следов нефти в струе или на поверхности моря сброс остатков чистого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 балласта за борт необходимо немедленно прекратить. Остатки балласта перекачать в отстойный танк}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или сдать в береговые очистные сооружения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.31. Перед приемом изолированного балласта ответственное за балластные операции лицо,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 если это возможно, должно осмотреть танки изолированного балласта и убедиться, что проходящий}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 по ним грузовой трубопровод и переборки, отделяющие эти танки от грузовых танков с нефтью, целы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и не имеют протечек.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 16.32. С приходом в порт погрузки перед сбросом изолированного балласта помощник}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 капитана, ответственный за балластные операции, если это возможно, должен осмотреть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поверхность балласта в танках. Если в каком-либо танке с изолированным балластом будет}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обнаружена нефть, то балласт из этого танка должен обрабатываться, как грязный.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3210{\tab\f0\cf1\fs24 \b 17. Предотвращение образования опасных зарядов}\par}{\pard \sl-308\par}{\pard \sl-0\tx4410{\tab\f0\cf1\fs24 \b статического электричества}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.1. На танкерах статическое электричество представляет большую опасность, так как многие из}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов обладают способностью аккумулировать опасные заряды статического}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электричества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.2. Образовавшееся в нефтепродуктах статическое электричество может привести к взрыву и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожару, если потенциал поля зарядов достигнет определенной величины, при которой возникает}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 искровой разряд, и если энергия разряда достаточна для воспламенения данной концентрации}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывоопасной смеси паров нефтепродуктов с воздухом.}\par}{\pard \sl-203\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24     17.3. К электризующимся  относятся  все  виды  перевозимых  на}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24                                                            -6}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 танкере нефтепродуктов с удельным сопротивлением  свыше  10   Ом x}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 м,   обладающие   способностью   при   трении   и   разбрызгивании}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 генерировать и удерживать электростатические заряды.}\par}{\pard \sl-248\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.4. При эксплуатации танкера необходимо руководствоваться Правилами по защите от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 статического электричества на морских судах, утвержденными Приказом ММФ N 131 от 6 августа}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 1973 г., а также настоящими Правилами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.5. Электростатическая защита должна осуществляться на всех нефтеналивных судах,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предназначенных для перевозки сырой нефти, нефтепродуктов и других органических жидкостей с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 температурой вспышки ниже 60 град. C.}\par}{\pard \sl-218\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-803\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.6. Средством электростатической защиты для отвода зарядов статического электричества}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 является заземление всех электропроводных деталей судовых систем и оборудования,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 расположенных во взрывоопасных помещениях и пространствах и контактирующих с электрически}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 активными средами - нефтепродуктами, водой и водными растворами для механизированной мойки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков, транспортируемым по магистралям паром, воздухом и другими газами, содержащими}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 твердые и жидкие частицы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Мероприятия по электростатической защите должны осуществляться и в обычных зонах судна}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 при возможности переноса каким-либо образом зарядов статического электричества из этих зон в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опасные.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.7. Перед подачей на борт танкера грузовых шлангов корпус танкера должен быть надежно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соединен с береговым заземляющим устройством с помощью специального заземляющего кабеля.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Отключение корпуса судна от берегового заземляющего устройства должно производиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 после отсоединения грузовых шлангов от судовых приемников. При нарушении заземления грузовые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операции должны быть приостановлены до устранения неполадок.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Необходимо следить за тем, чтобы перед соединением и рассоединением заземляющего кабеля}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судовой выключатель находился в положении "Выключен". Только после того, как кабель надежно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закреплен, выключатель ставится в положение "Включен".}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.8. Грузовые шланги должны быть с токопроводящим проводником, электрически}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соединенным с его фланцами.}\par}{\pard \sl-203\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24     Грузовые  шланги  должны  иметь  конструкцию,   обеспечивающую}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 стекание  электростатических  зарядов,  с   общим   сопротивлением}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24           6}\par}{\pard \sl-218\par}{\pard \sl-0\tx735{\tab\f1\cf1\fs24 порядка 10  Ом.}\par}{\pard \sl-248\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.9. При использовании в грузовой шланговой линии изолирующего фланца или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токонепроводящего шланга все металлические части изолирующего фланца или токонепроводящего}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шланга с береговой стороны должны быть электрически связаны с системой заземления на причале, а}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 все металлические части фланца или шланга с морской стороны должны быть электрически связаны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 с судном.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.10. В первоначальный период заполнения грузовых танков электростатически активным}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузом скорость движения жидкости в приемных трубах танков не должна превышать 1 м/с вплоть до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 достижения уровня груза в 1 м в каждом загружаемом через приемные трубы танке. Затем скорость}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 потока груза может быть увеличена до предела, указанного в судовых документах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Для танкеров с двойным дном, оборудованных специальным антистатическим колодцем в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых танках, скорость потока груза не регламентируется.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Максимальная скорость движения нефтепродуктов по судовому грузовому трубопроводу при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погрузке не должна превышать 12 м/с.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.11. Применение антистатических присадок для увеличения проводимости электризующихся}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов может устранить необходимость выполнения рекомендаций относительно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ограничений скорости потока.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.12. Если при перекачке нефтепродуктов применяются фильтры тонкой очистки, то могут}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 потребоваться такие меры предосторожности, как уменьшение скорости потока, так как фильтры}\par}{\pard \sl-83\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тонкой очистки могут быть генераторами статического электричества большой мощности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.13. Электризующиеся нефтепродукты не должны грузиться "через верх", так как при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разбрызгивании образуются опасные заряды статического электричества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Погрузка в танки и перекачка из одних танков в другие электризующихся нефтепродуктов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны осуществляться только по грузовым трубопроводам.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.14. Запрещается заполнение недегазированных танков балластом через горловину танка, так}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 как в газовом облаке может накапливаться опасный заряд электричества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.15. Во время погрузки для замера пустот в грузовых танках и отбора проб не должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 использоваться ручные стальные рулетки, металлические пробоотборники, металлические замерные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 футштоки или подобные токопроводящие инструменты. Для этих целей могут использоваться только}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токонепроводящие ручные замерные инструменты. При этом они должны быть негигроскопичными.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Отбор проб груза необходимо производить с учетом требований ГОСТ 2517-80.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.16. После окончания погрузки замер груза или отбор проб с использованием}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электропроводящих приборов может быть произведен не раньше чем через 30 мин. после окончания}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загрузки каждого танка, что даст возможность рассеяться накопившимся электростатическим зарядам.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.17. Для измерения уровня груза в танках рекомендуется применение стационарных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 бесконтактных дистанционных уровнемеров.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.18. После окончания погрузки запрещается производить продавливание остатков груза из}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 стендеров и грузовых шлангов сжатым воздухом и инертным газом в грузовые танки, в которые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 погружены нефтепродукты, аккумулирующие статическое электричество, или в которых перед этим}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перевозились такие нефтепродукты и которые не дегазировались перед погрузкой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.19. Пар не должен впускаться в недегазированные танки с большой скоростью. Если}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходима подача пара в недегазированные танки, то его следует впускать с малой скоростью.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.20. При пропаривании недегазированных танков не допускается вводить в танк моечные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 машинки, вентиляторы и другие токопроводящие предметы до полного конденсирования пара. При}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 этом обязательно произвести заземление корпусов указанных устройств.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.21. При мойке танков подачу воды, моечного раствора необходимо начинать малой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 скоростью с целью постепенного смачивания внутренних поверхностей шлангов и систем для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предотвращения чрезмерной электризации сильной струей.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.22. Применение переносных моечных машинок при работе в недегазированных танках}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должно быть ограничено (см. п. 20.29), а применение стационарных высокопроизводительных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моечных машинок разрешается только в среде инертных газов (см. п. 20.19).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.23. Вся шланговая линия должна быть собрана и проверена на непрерывность электрической}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 цепи до того, как моечная машинка будет опущена в танк, и шланги не должны разобщаться или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсоединяться от палубной моечной магистрали до тех пор, пока машинка не будет удалена из танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.24. При осушении шланговой линии моечной машинки необходимо только частично}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приотдать соединение с палубной моечной магистралью, а после осушения опять плотно соединить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и только после этого извлекать моечную машинку из танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.25. При мойке недегазированных танков из-под электризующихся нефтепродуктов не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рекомендуется употреблять рециркуляционную воду и химические неантистатические моющие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 растворы без предварительного инертирования танков, так как существует вероятность образования в}\par}{\pard \sl-233\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 них опасного заряда статического электричества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Мойка недегазированных танков таким способом, без предварительной инертизации, может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 осуществляться только в том случае, если постоянный контроль показывает, что концентрация паров}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 углеводородов в танках не находится в пределах взрываемости или применяется антистатический}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моющий препарат.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.26. При мойке недегазированных танков, если они не заполнены инертным газом, моющую}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воду не рекомендуется нагревать выше 60 град. C, если в танках имеются остатки электризующихся}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, так как в них может образоваться опасный заряд статического электричества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.27. Во время мойки недегазированных танков в них образуется водяной и нефтяной туман, в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 котором могут накапливаться опасные заряды статического электричества, поэтому замерять уровень}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моющей воды на днище танка металлической рулеткой или футштоком разрешается только через}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 замерную трубку.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.28. Если в танке отсутствует замерная трубка, то ввод в атмосферу вымытого танка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 металлического предмета может быть осуществлен только через 5 ч после окончания мойки танков.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Если танк интенсивно вентилируется, то ввод металлического предмета может быть осуществлен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 через 4 ч. На неметаллические замерные приборы это правило не распространяется.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.29. При работе в недегазированных танках запрещается использовать одежду,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 накапливающую на своей поверхности статическое электричество.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.30. При протирке грузовой палубы, днищ и переборок танков от остатков нефтепродуктов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 запрещается пользоваться ветошью, швабрами и щетками из синтетического материала, так как}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможно воспламенение от образовавшихся опасных зарядов статического электричества.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 17.31. При производстве на судне ремонтных и других работ специалистами береговых служб}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судовая администрация должна требовать выполнения ими мероприятий по защите судна и груза от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 образования опасных зарядов статического электричества.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4275{\tab\f0\cf1\fs24 \b 18. Применение инертного газа}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.1. Инертный газ для заполнения грузовых танков может быть использован на всех стадиях}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рейса, исключая то время, когда требуется безопасный вход людей в эти помещения без дыхательных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 аппаратов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.2. Эксплуатация и уход за системой инертных газов должны производиться в строгом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствии с инструкцией по эксплуатации системы, издаваемой заводом-изготовителем.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.3. Содержание кислорода в инертном газе не должно превышать 5% объемных, при этом в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 газе должны отсутствовать окись углерода и другие горючие примеси. При увеличении содержания}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 кислорода до 8% объемных должна срабатывать световая и звуковая сигнализация предупреждения.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Температура газа, поступающего в грузовые танки, должна быть не более 65 град. C.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.4. Давление инертного газа в грузовых танках не должно превышать 0,017 МПа (0,17 кгс/кв.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 см), исключая танки, спроектированные для высоких давлений. При этом должны использоваться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 высокочувствительные приборы для контроля за давлением.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.5. В состав инертных газов могут входить двуокиси серы или окислы азота, которые}\par}{\pard \sl-173\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обладают токсичностью, поэтому при работе с ними необходимо соблюдать меры}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предосторожности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.6. Применение системы инертных газов на танкере не гарантирует абсолютную}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывопожаробезопасность в связи с возможностью попадания атмосферного кислорода в инертные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 газы, поэтому на танкерах с системами инертных газов не должны ослабляться обычные меры}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожарной безопасности.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.7. Инертными газами нельзя воздействовать на внешние очаги загорания, например при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загорании нефтепродуктов, разлитых на грузовую палубу, при пожаре в грузовом танке, получившем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пробоину при столкновении, и др., так как инертные газы легко обогащаются кислородом воздуха.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.8. При погрузке нефтегрузов в инертированные танки подача инертного газа в танки должна}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть прекращена и отвод газов должен производиться в атмосферу через газоотводную систему}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков. Дыхательные клапаны газоотводной системы "давление - вакуум" в этом случае должны быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открыты только на время, пока идет погрузка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.9. Если грузовые танки заполнены инертным газом под давлением, то нельзя открывать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 крышки горловин танков, смотровых и моечных лючков, например, для замера уровня груза или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отбора проб, до тех пор, пока в танке давление не будет уменьшено и не сравняется с наружным.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.10. При открывании крышек горловин или моечных лючков следует находиться в стороне от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 них и ни в коем случае не стоять над ними.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.11. Перед началом погрузки необходимо в грузовых танках замерить содержание кислорода в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инертном газе и данные записать в судовой журнал.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.12. При плавании с грузом или в балласте утечки инертного газа из грузовых танков могут}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 происходить при изменении температурных условий.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При повышении температуры воздуха и воды давление газов в танках увеличивается и часть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 газов выпускается в атмосферу через газоотводную систему. При понижении температуры воздуха и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воды давление газов в танках падает и в них поступает атмосферный воздух, поэтому бывает}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо произвести подкачку инертных газов в грузовые танки. Подкачку газа рекомендуется}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 производить в жаркое время суток, чтобы в последующем избежать подрыва предохранительных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клапанов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.13. Пустые грузовые танки, в которых не перевозится груз, также должны заполняться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инертным газом, так как в них могут скапливаться пары нефтепродуктов, а также перетекать груз из}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 смежных танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.14. При выгрузке система инертных газов должна работать постоянно, чтобы поддерживать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимое давление газов в танках.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Во избежание попадания наружного воздуха разгерметизация грузовых танков не допускается.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Дыхательные клапаны газоотводной системы должны быть закрыты. Замер уровня груза в танках}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должен производиться закрытой системой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.15. Во время выгрузки необходимо контролировать давление газов в грузовых танках, так как}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 количество поступающих в грузовые танки инертных газов может быть меньше по объему количества}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выкачиваемого груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В случае снижения давления газов в грузовых танках при работающем нагнетателе необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 уменьшить производительность грузовых насосов.}\par}{\pard \sl-443\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.16. Если после выгрузки возникает необходимость проверки остатков груза с помощью}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 рулетки или футштока, необходимо остановить вентиляторы системы инертных газов, закрыть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 клапаны на все танки, стравить избыточное давление и после этого выполнить замеры.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 После проведения замеров необходимо поднять давление газа до номинального.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.17. При производстве балластных операций система инертных газов должна работать в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 таком же режиме, как и при проведении грузовых операций.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.18. При мойке танков стационарными моечными машинками давление инертных газов в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танках следует поддерживать в пределах, не превышающих давления, при котором происходит}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выброс газов из танка через дыхательные клапаны газоотводной системы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.19. При мойке танков переносными моечными машинками давление инертных газов в танках}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 следует поддерживать несколько больше атмосферного, чтобы предотвратить попадание кислорода в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моющиеся танки из внешней среды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Перед тем как переносить моечные машинки из одного танка в другой, давление инертных газов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в этих танках следует снизить до атмосферного.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.20. Перед началом мойки и после ее окончания необходимо замерить содержание кислорода}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в атмосфере танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.21. После окончания мойки грузовые танки должны быть вновь заполнены инертным газом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 до номинального давления, если танкер опять идет под погрузку нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.22. Перед спуском людей в танки для профилактического осмотра или проведения работ}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо проверить газоанализатором, нет ли в танке инертного газа или паров нефтепродуктов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверить закрытие клапанов, через которые может подаваться инертный газ, и убедиться, что танк}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 не сообщается с другими, заполненными инертным газом. Также должен быть сделан анализ воздуха}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в танке на содержание кислорода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Во время нахождения людей в танке должна производиться его вентиляция свежим воздухом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 18.23. Во время погрузки, приема балласта или дегазации танков, когда из них вытекает}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инертный газ, все иллюминаторы и двери, выходящие на грузовую палубу, должны быть закрыты во}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 избежание попадания его в судовые помещения. Также необходимо принять меры,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предупреждающие захват инертного газа общесудовой вентиляцией через палубные приемники}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воздуха.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3945{\tab\f0\cf1\fs24 \b 19. Работа в недегазированном танке}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.1. Вход людей в грузовой танк или другой отсек для производства работ или осмотра}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разрешается только после его полной дегазации до санитарных норм (см. Приложение 2). Если рядом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 с дегазированным танком расположены недегазированные танки, то за работающими в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дегазированном танке должно быть организовано постоянное наблюдение и подготовлены два}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 комплекта шланговых или изолирующих противогазов, предохранительных поясов с лямками, со}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 страховыми канатами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.2. Для поддержания в дегазированном танке воздушной среды в пределах санитарной нормы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 его необходимо все время вентилировать, пока в нем работают люди. При этом необходимо}\par}{\pard \sl-173\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 периодически проводить контрольные проверки на загазованность.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.3. Для определения безопасных концентраций, соответствующих санитарным нормам,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо пользоваться газоанализаторами УГ-2 или другого типа, пригодными для этой цели.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.4. Вход людей в недегазированный грузовой танк или другой отсек может быть разрешен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 только в исключительных случаях (если танк невозможно дегазировать) для выполнения неотложных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 работ (ремонта грузовых клинкетов или трубопровода, заделки пробоины в корпусе судна, заводки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моечных машинок и др.) при выполнении следующих требований:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вход людей в недегазированный танк может быть допущен только с разрешения капитана;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 до входа людей в танк его необходимо провентилировать с целью максимально возможного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 снижения концентрации вредных паров и газов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 трапы, площадки трапов и поручни внутри танка должны быть промыты от остатков вязких}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вход людей одновременно более чем в один недегазированный танк запрещается;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 в недегазированном танке запрещается одновременная работа более двух человек;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 входящий в танк должен надеть защитную одежду, обувь, ударозащитную каску, изолирующий}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или шланговый дыхательный противогаз, а также предохранительный пояс с лямками, со страховым}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 канатом;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 посещение недегазированного танка разрешается только в светлое время суток, если крен судна}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 при качке составляет не более 5 град.;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 работающий в танке и наблюдающий на палубе твердо усвоили установленную сигнализацию.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.5. При посещении судовых отсеков, в которых имеются пары нефтепродуктов, в качестве}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 средств индивидуальной защиты органов дыхания необходимо пользоваться шланговым}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дыхательным противогазом или изолирующим противогазом с воздушными баллонами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Запрещается применять во избежание возможного взрыва изолирующие противогазы с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 кислородными баллонами в районах, где имеются пары углеводородов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.6. Запрещается пользоваться фильтрующими противогазами в районах, где имеются пары}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов и подозревается недостаточное для дыхания количество кислорода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Перед тем как использовать фильтрующий противогаз, необходимо убедиться, что он}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предназначен для защиты от данного газа.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.7. Воздуходувка для подачи воздуха к шланговому дыхательному противогазу должна}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 устанавливаться в таком месте, чтобы забор воздуха осуществлялся из зоны, где нет вредных газов. За}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ее работой, состоянием воздушных шлангов должно все время вестись наблюдение.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.8. На время работы людей в недегазированном танке на палубе, в районе входного люка,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны находиться два наблюдателя. Наблюдающие должны быть снабжены свистком для вызова}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 людей на случай оказания помощи работающим в танке.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.9. У входного люка недегазированного танка, в котором работают люди, должны находиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 в полной готовности к немедленному использованию не менее двух комплектов шланговых или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изолирующих дыхательных противогазов, предохранительных поясов с лямками, со страховыми}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 канатами и взрывозащищенный фонарь.}\par}{\pard \sl-203\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.10. Наблюдающие у входного люка недегазированного танка должны находиться с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 наветренной стороны, не выпускать из рук страховых канатов, держать их натянутыми, непрерывно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 наблюдать за работающими в танке и поддерживать с ними связь с помощью установленных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сигналов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.11. Если работающий в недегазированном танке обнаружил нарушение нормальной подачи}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воздуха, почувствовал запах нефтепродуктов под маской или недомогание, он должен подать сигнал}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 о выходе и немедленно направиться к выходу из танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 19.12. Перед тем как посылать людей для осмотра или производства работ в примыкающие к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовым танкам отсеки (коффердамы, двойное дно и др.), остающиеся долгое время закрытыми,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо хорошо провентилировать их и произвести анализ воздуха на отсутствие токсичных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 газов и наличие достаточного для дыхания количества кислорода. За работающими должно быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 организовано постоянное наблюдение и подготовлены два комплекта дыхательных противогазов и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предохранительных поясов со страховыми канатами.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3030{\tab\f0\cf1\fs24 \b 20. Меры безопасности при мойке и дегазации танков}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.1. Производственная среда, в которой происходит моечный процесс, является}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывоопасной и токсичной, поэтому лица, допущенные к выполнению моечных работ, должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пройти все виды инструктажа в соответствии с Положением об инструктаже на морском транспорте.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.2. К выполнению моечных работ допускаются только лица, прошедшие специальное}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обучение по противопожарной безопасности, безопасным приемам и методам работы на рабочих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 местах. Личный состав должен знать свойства и особенности перевозимых грузов, степень их}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опасности, уметь применять средства коллективной и индивидуальной защиты от воздействия}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузов, а также знать приемы оказания первой медицинской помощи пострадавшим от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соприкосновения с грузом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.3. Мойку грузовых танков следует выполнять, руководствуясь РТМ 31.2006-78 "Мойка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовых танков и топливных цистерн танкеров", при соблюдении настоящих Правил и Правил}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 техники безопасности на судах морского флота.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.4. Технологические процессы мойки танков должны проводиться с учетом выполнения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требований действующей Конвенции по предотвращению загрязнения моря нефтью в части сброса}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 за борт нефтесодержащих вод и Постановления Совета Министров СССР от 14 февраля 1974 г. N 118}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 "Об усилении борьбы с загрязнением моря веществами, вредными для здоровья людей и живых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ресурсов моря".}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.5. Организация и проведение технологического процесса мойки танков должны}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предусматривать максимально возможную механизацию трудоемких операций и устранение}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воздействия на человека опасных и вредных производственных факторов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Работы по мойке и дегазации танков связаны с большой пожарной опасностью и опасностью}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отравлений, поэтому при их производстве необходимо строго выполнять правила безопасности и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соблюдать режим, установленный для выполнения грузовых операций с легковоспламеняющимися}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 летучими нефтепродуктами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.6. Мойка грузовых танков может производиться как по замкнутому, так и по разомкнутому}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 циклу.}\par}{\pard \sl-128\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-893\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При нахождении судна в прибрежных и внутренних водах, а также в особых районах мойка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должна проводиться только по замкнутому циклу, без слива промывочной воды в море.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.7. Мойка грузовых танков водным раствором моющего химического препарата может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проводиться только по замкнутому циклу. Отработанный раствор должен сохраняться на судне и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сдаваться на береговые очистные сооружения или плавучую зачистную станцию.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В качестве моющих химических средств должны применяться только препараты, одобренные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 органами санитарного надзора и органами по охране вод и допущенные к применению на судах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.8. Неводная мойка грузовых танков может проводиться только после согласования вопроса с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовладельцем и администрацией порта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Мойка танков сырой нефтью проводится только в период разгрузки танкера с удалением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 использованной для мойки нефти на берег вместе со сливаемым грузом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Мойка растворителями при подготовке грузовых танков под смену сорта груза проводится}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 методом прокачки. Собранный из танков после мойки растворитель сдается на берег.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.9. После окончания мойки грузовых танков слив отстоявшейся промывочной воды из}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отстойных танков выкачивается за борт в открытом море с соблюдением условий действующей}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Конвенции или сдается на берег в очистные сооружения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Нефтяные остатки, собранные после мойки танков, должны быть сданы на берег.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.10. При мойке танков любым из вышеописанных способов во избежание попадания нефти за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борт необходимо соблюдать следующие меры предосторожности:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 приемники на палубных грузовых, зачистных и моечных трубопроводах, которые по принятой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 технологии не участвуют в мойке танков, должны быть надежно закрыты;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 донная и забортная арматура насосного отделения должна быть надежно закрыта;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 перед началом мойки промыть моечные трубопроводы со сливом промывочной воды в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отстойный танк;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 палубные шпигаты держать закрытыми;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 попавшую на грузовую палубу моющую жидкость убирать немедленно;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 при выкачке воды за борт вести контроль за содержанием нефти в ней при помощи экспресс-}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 анализа или автоматических приборов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.11. За безопасность подготовки и проведения моечных работ несут ответственность:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 старший помощник капитана - за работы в грузовых танках;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 старший (главный) механик - за работы в топливных цистернах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.12. Членам экипажа, участвующим в производстве моечных работ, должны выдаваться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пригодные для этой цели спецодежда, обувь, надлежащие средства индивидуальной защиты.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Спецодежда должна быть нефте- и влагозащитной и сохранять эластичность при воздействии на нее}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 влаги. Спецодежда должна быть изготовлена из антистатического материала.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.13. Переносные моечные машинки, шланговые соединения, переносные вентиляторы и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инвентарь, используемые при мойке и дегазации танков, должны удовлетворять требованиям}\par}{\pard \sl-233\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывобезопасности в условиях возможных соударений с судовыми конструкциями.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.14. Мойку танков запрещается производить в период грузовых операций с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 легковоспламеняющимися летучими нефтепродуктами, за исключением мойки сырой нефтью на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танкерах, оборудованных стационарной системой мойки танков и системой инертных газов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.15. Мойку танков при помощи переносных моечных машинок запрещается производить в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 штормовую погоду, при качке судна, вызывающей удары моечных машинок о борт или набор танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.16. Во время грозы с электрическими разрядами моечные работы должны прекращаться и все}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моечные горловины следует закрыть до полного прекращения грозовых разрядов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.17. В ночное время район моечных работ должен освещаться:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275\tx7275\tx8025{\tab\f0\cf1\fs24 на стоянке - прожекторами с мостика и мачтовых }{\tab\f0\cf2\fs24 \ul колонн}{\tab\f0\cf1\fs24  в соответствии с нормами}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 искусственного освещения на судах морского флота;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 в рейсе, когда палуба не освещена прожекторами, следует пользоваться взрывозащищенными}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 фонарями. Применение светильников с электрическим кабелем запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.18. При подготовке к мойке танков нельзя открывать горловину танка или моечный лючок до}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тех пор, пока внутреннее давление в танке не будет уменьшено и не сравняется с наружным}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 атмосферным.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.19. Мойка грузовых недегазированных танков стационарными машинками с расходом воды}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 от 60 куб. м/ч и более должна производиться только в среде инертных газов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.20. При мойке танков с помощью переносных моечных машинок необходимо применять}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шланги из антистатического материала. При этом соединения рукавов между собой и моечной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 машинкой должны быть выполнены так, чтобы обеспечивался надежный электрический контакт}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 между моечной машинкой и корпусом судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При отсутствии специальных шлангов из антистатического материала моечные машинки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо заземлять на корпус судна при помощи медного гибкого проводника.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.21. Запрещается применять для мойки танков шланги, имеющие повреждения и изношенные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 места (разрывы, отслоения внутренней поверхности, выпучины и др.). Детали соединения шлангов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должны быть выполнены из безыскровых материалов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.22. Все шланговые соединения должны быть собраны до того, как машинка будет опущена в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танк, и шланги не должны разобщаться или отсоединяться от палубной магистрали до тех пор, пока}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 машинка не будет удалена из танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Для осушения шлангов необходимо частично приотдать соединение на палубе, а после}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 осушения опять соединить до тех пор, пока машинка не будет извлечена из танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.23. Замер собравшейся в моющемся танке воды футштоком или рулеткой или ввод в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моющийся танк другого подобного предмета должен производиться только через замерную трубку.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Если замерная трубка отсутствует, эта операция (ввод постороннего предмета в моющийся танк)}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 может быть осуществлена только через 5 ч после окончания мойки танков, так как электрический}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заряд может присутствовать в образовавшемся в танке водяном или нефтяном тумане.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.24. Неиспользованные моечные горловины танка следует держать закрытыми во избежание}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опасного выброса струй моющей воды. В рейсе при производстве моечных работ в ночное время,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 когда палуба не освещается прожекторами, открывать крышки моечных горловин для вентиляции}\par}{\pard \sl-113\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков запрещается. В этих случаях для вентиляции танков следует открывать только крышки}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 входных горловин танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.25. При работе моечных машинок необходимо принимать меры, предотвращающие выброс}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моющей воды через горловины на палубу. С этой целью необходимо пользоваться специальными}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 кронштейнами либо закрывать просвет между крышкой и комингсом горловины матом или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 брезентом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.26. Перестановка моечных машинок должна производиться только после прекращения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подачи моющей воды к машинкам и при отсутствии давления в моечных шлангах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.27. Запрещается вводить в танк из-под нефтепродуктов, заполненный паром, моечные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 машинки до тех пор, пока пар не сконденсируется, а также заполнять паром танки, в которые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опущены моечные машинки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.28. Грузовые танки, предназначенные для мойки, могут содержать взрывоопасные пары в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 следующих случаях:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 после выгрузки из них легковоспламеняющихся (летучих) нефтепродуктов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 после выгрузки нефтепродуктов средней воспламеняемости и трудновоспламеняющихся,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 которые были погружены в недегазированный танк.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.29. При мойке танков с неконтролируемой по содержанию паров нефтепродуктов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 атмосферой, которое может быть выше, ниже и в пределах зоны взрываемости, если отсутствует}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 система инертных газов, необходимо принять следующие меры предосторожности, чтобы избежать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 присутствия в танке источников воспламенения от опасных зарядов статического электричества:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 количество переносных моечных машинок, используемых одновременно в одном отсеке, не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должно быть больше четырех, если применяются машинки малой производительности (до 35 куб.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 м/ч), и не больше трех, если применяется тип машинок высокой производительности (от 35 до 60 куб.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 м/ч);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 моечная вода не должна быть нагрета выше 60 град. C.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.30. При мойке танков с обедненной парами нефтепродуктов атмосферой, когда содержание}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 паров ниже 50% нижнего предела взрываемости, если отсутствует система инертных газов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо принять следующие меры предосторожности:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 если газоотводная система на танкере общая для группы танков, то газоотводная труба}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моющегося танка должна быть отсечена от общей магистрали, чтобы предотвратить поступление}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 паров нефтепродуктов из других танков;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 до начала мойки днище танка должно быть промыто водой и зачищено; грузовые трубопроводы,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 насосы, перемычки также должны быть промыты водой;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 до начала мойки танк должен вентилироваться до тех пор, пока концентрация паров}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов в его атмосфере не уменьшится до 10% ниже нижнего предела взрываемости;}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 проверка загазованности должна быть сделана на различных уровнях танка;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 механическая вентиляция и отбор проб из атмосферы танка должны производиться на всем}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 протяжении мойки танков;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 мойка должна быть приостановлена, если загазованность в танке увеличилась до 50% нижнего}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предела взрываемости; мойка может быть возобновлена, когда после продолжавшейся вентиляции}\par}{\pard \sl-323\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 концентрация паров уменьшится до 20% нижнего предела взрываемости;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 для мойки не должна использоваться рециркуляционная вода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.31. При мойке танков, заполненных инертными газами, необходимо выполнять следующие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 меры предосторожности:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 содержание кислорода в атмосфере танка должно контролироваться на всем протяжении его}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мойки и не должно превышать 8% объема;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 давление инертных газов должно быть выше атмосферного на протяжении всей мойки, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предотвратить поступление наружного воздуха внутрь танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.32. При мойке танков с обогащенной парами нефтепродуктов атмосферой, когда содержание}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 паров выше верхнего предела взрываемости и составляет не менее 15% объемных, если отсутствует}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 система инертных газов, рекомендуются следующие меры предосторожности:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 мойка по этому методу может производиться только по специальной инструкции пароходства;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 в период мойки танков необходимо контролировать, чтобы в результате поступления наружного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воздуха в танк или поглощения паров нефтепродуктов моющими средствами атмосфера в танке не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 стала взрывоопасной.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.33. При проведении моечных и дегазационных работ в коффердамах, насосных отделениях,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 топливных танках и других отсеках должны неуклонно выполняться те же меры по обеспечению}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасности, как и при мойке и дегазации грузовых танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.34. Если перед мойкой танков в них перевозился груз, обладающий повышенной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токсичностью, должны быть приняты особые меры предосторожности, чтобы не допустить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отравления работающих на грузовой палубе членов экипажа (см. п. 14 "Перевозка нефтепродуктов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 повышенной токсичности").}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.35. Перед входом людей в танк, в который опущены переносные моечные машинки, должен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть остановлен моечный насос и перекрыты концевые клапаны, к которым присоединены моечные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 шланги.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.36. Для ручной домывки танков должна применяться только моющая вода при давлении не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 более 0,6 МПа (6 кгс/кв. см), с температурой не выше 45 град. C.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Производить ручную домывку с применением в качестве моющей жидкости растворителей}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (керосин, дизельное топливо и др.) запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.37. Работы по ручной домывке в одном танке рекомендуется производить одновременно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 двумя мойщиками. Одновременная работа более двух мойщиков в одном недегазированном танке не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 допускается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.38. При мойке и зачистке танков, в которых перевозились этилированные нефтепродукты}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или нефтепродукты повышенной токсичности, люди, работающие в них по удалению остатков или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ржавчины, должны быть полностью одеты в защитную одежду и использовать шланговые или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изолирующие дыхательные противогазы. При этом следует избегать попадания грязи на кожу. В}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 случае какого-либо загрязнения кожи это место необходимо немедленно промыть водой с мылом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.39. На танкерах, которые продолжительное время используются на перевозках сернистых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сортов нефти, на внутренних поверхностях их танков и трубах может отложиться пирофорическое}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 сернистое железо в виде окалины. В этих случаях окалину необходимо периодически удалять, так как}\par}{\pard \sl-323\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 собравшаяся в большом количестве, если ей дать высохнуть, она может воспламениться при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соединении с кислородом. Периодичность моечных работ должна выполняться в соответствии с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 требованиями РТМ 31.2006-78.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.40. После удаления пирофорической окалины из танка ее нельзя хранить в сухом виде, а}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо смачивать водой до тех пор, пока окалина не будет удалена с судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.41. При производстве работ в грузовом танке инструмент необходимо опускать в танк в ведре}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или брезентовом мешке, а не держать при себе, спускаясь или поднимаясь из танка по трапу.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 20.42. При подъеме из танка твердых и жидких остатков нефтегрузов канат должен быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 оснащен карабином, чтобы исключить падение кадок и ведер на днище танка.}\par}{\pard \sl-818\par}{\pard \sl-0\tx4170{\tab\f0\cf1\fs24 \b 21. Мойка танков сырой нефтью}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.1. Мойку танков грузом сырой нефти рекомендуется производить с целью:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 более полного удаления из танков загустевших остатков груза за счет использования свойств}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефти растворять смолистые парафино-асфальтовые отложения;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 предотвращения загрязнения моря нефтью при мойке за счет устранения контакта нефти с водой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и исключения необходимости в сепарации промывочной воды от нефти и слива ее в море.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.2. В зависимости от назначения мойка грузом нефти может выполняться как окончательная,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 так и предварительная.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.3. Окончательная мойка производится:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 на балластный переход;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 с целью профилактического удаления отложений остатков груза (без ручной выборки твердых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 остатков).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.4. Предварительная мойка производится под ремонтные работы, осмотр танков и смену вида}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груза.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 После предварительной мойки сырой нефтью с целью дегазации танков должна быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 произведена мойка забортной водой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.5. Мойкой танков грузом сырой нефти достигаются по сравнению с водной мойкой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 следующие преимущества:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 сокращение объема ручного труда на выборку загустевших остатков;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 увеличение грузовместимости судна за счет более полного удаления неоткачиваемых остатков}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 груза при выгрузке;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 сокращение потерь груза, удаляемого при водной мойке;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 исключение обводнения груза сырой нефти забортной водой, что происходит при водной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мойке;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 сокращение затрат времени отдельно на моечные операции за счет совмещения их с грузовыми}\par}{\pard \sl-113\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операциями;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 уменьшение коррозии корпуса судна от ударного воздействия на металл моющих струй морской}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.6. Мойку грузовых танков сырой нефтью допускается производить из-под груза сырой нефти}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и в среде инертных газов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.7. Танкер, оборудованный системой мойки танков сырой нефтью, должен быть обеспечен}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инструкцией по эксплуатации и оборудованию данной системы, содержащей детальное описание}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 системы и оборудования и излагающей последовательность технологических операций. Указанная}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инструкция является руководством для экипажа танкера по эксплуатации системы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.8. Если по каким-либо причинам нельзя выполнить всех условий, указанных в инструкции,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 мойка танков сырой нефтью не должна производиться.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.9. К мойке танков сырой нефтью могут допускаться только те члены экипажа, которые имеют}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 на руках специальный документ, подтверждающий, что ими пройдена соответствующая подготовка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.10. Мойка танков сырой нефтью должна осуществляться под руководством ответственного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 лица, назначенного из членов экипажа.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.11. Мойка танков сырой нефтью может выполняться одно- или двухэтапным способом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При одноэтапном способе мойка каждого танка производится после окончания его разгрузки с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отбором моющей нефти из других танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При двухэтапном способе первый этап - мойка переборок - совмещается с выгрузкой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 замываемого танка; второй этап - мойка днища - производится после полной разгрузки танка с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отбором моющей нефти из сливаемого груза других танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.12. До прибытия танкера в порт и до начала мойки танков сырой нефтью необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 произвести проверку следующих технических средств моющей системы и системы инертных газов:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 трубопроводов и клапанов моечной системы на герметичность (гидравлическое опрессование);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 надежной работы вентилятора и предохранительных устройств системы инертных газов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 работы измерительных приборов системы инертных газов постоянного и непрерывного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 показания и регистрации давления, а также содержания кислорода;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 работы системы дистанционного указания уровня нефти в танках и системы максимального}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 уровня.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 О проведенной проверке и об отсутствии пропусков в системе необходимо сделать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующую запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.13. С прибытием в порт разгрузки судно должно представить портовой администрации}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 доказательство, что оно способно осуществлять мойку танков сырой нефтью с соблюдением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующих мер безопасности. Для этого необходимо представить подписанный капитаном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 список технических проверок, произведенных на судне до его прибытия в порт выгрузки, и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соответствующую запись в судовом журнале.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Ответственный представитель портовой администрации может произвести проверку степени}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 готовности судна и членов экипажа к проведению мойки танков сырой нефтью.}\par}{\pard \sl-503\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.14. До начала мойки танков сырой нефтью необходимо выполнить следующие мероприятия:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 произвести проверку работы системы инертных газов и процентного содержания кислорода в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инертных газах;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 произвести выгрузку на берег 2 - 3 м груза из танков, подлежащих мойке, с тем чтобы исключить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможность попадания подтоварной воды в моющую нефть и этим избежать риска образования}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опасного электростатического заряда и создать достаточные пустоты для производства мойки;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 опрессовать моечный трубопровод нефтью давлением не менее 0,8 МПа (8 кгс/кв. см) и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обеспечить на весь период моечных работ контроль за утечками нефти и устранение их в случае}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 появления.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.15. Мойку танков сырой нефтью в порту выгрузки можно производить только после}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 получения разрешения на это портовых властей.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.16. При производстве мойки танков сырой нефтью необходимо особое внимание уделять}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 следующим вопросам:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 постоянному наблюдению вахтенными за возможным появлением течи в трубопроводе}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 моечной системы;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 проверкам давления инертного газа в танках и допустимого уровня кислорода, который не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 должен быть выше 5%;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 поддержанию давления инертного газа в танках не ниже атмосферного, чтобы предотвратить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 попадание кислорода из внешней среды, и не выше номинального давления, при котором}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 происходит выброс газов через дыхательные клапаны газоотводной системы;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 проверкам уровня нефти в танках, которые не подвергаются мойке (с тем чтобы убедиться в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 перекрытии клапанов и отсутствии какой-либо утечки нефти);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 проверкам давления в трубопроводе моечной системы;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 поддержанию дифферента на корму от 3 до 6 м, который требуется при мойке танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.17. После окончания мойки танков сырой нефтью необходимо весь моечный трубопровод}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 промыть забортной водой в отстойный танк.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 21.18. Обо всех производящихся на судне операциях, относящихся к мойке танков сырой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтью, необходимо производить запись в судовой журнал.}\par}{\pard \sl-818\par}{\pard \sl-0\tx2820{\tab\f0\cf1\fs24 \b 22. Меры пожарной безопасности при ремонтных работах}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.1. Ремонтные работы, при которых используют открытый огонь, на нефтеналивных судах}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 относятся к особо опасным. Они требуют применения специальных мер, обеспечивающих пожарную}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 безопасность.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.2. В период подготовки танкера к ремонту и во время стоянки в ремонте необходимо строго}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выполнять требования Положения о ремонте судов, утвержденного Приказом ММФ от 15.09.78 N}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 192, РД 31.60.14-81, Правил пожарной безопасности при проведении огневых работ, утвержденных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Приказом ММФ от 12.03.73 N 41, Инструкции по организации спасания людей из помещений и}\par}{\pard \sl-143\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсеков судов при пожарах, утвержденной Главной морской инспекцией ММФ 16.05.73.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.3. Постановка танкера на отстой к причалам порта или завода может быть разрешена только}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 на основании судового акта о дегазации до взрывобезопасной нормы. Акт вручается капитану порта}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или завода. Постановка в док, к причалам завода или порта недегазированного танкера запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.4. Разрешается постановка в док судов с бункером и маслом в емкостях не более 5-суточного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 запаса. При этом район топливных отсеков отмечается на корпусе судна отличительной краской и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 делается надпись: "ОГНЕОПАСНО".}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.5. При стоянке судна на заводе в ремонте за противопожарное состояние судна в целом несет}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ответственность капитан судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 За обеспечение противопожарного состояния рабочих мест и безопасные в противопожарном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отношении методы работы несет ответственность работник завода, назначенный приказом директора}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судоремонтного завода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 На время стоянки судна в доке для обеспечения пожарной безопасности дублирующие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 противопожарные средства предоставляются заводом.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.6. Ремонтные работы внутри грузовых танков допускаются после полного удаления из}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков, коффердамов, насосных отделений, грузовых и зачистных трубопроводов всех остатков}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, ржавчины и тщательной зачистки и дегазации грузовых помещений и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубопроводов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.7. Письменное разрешение на огневые работы выдается администрацией предприятия,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 производящего ремонт судна, на основании акта химической лаборатории об отсутствии}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывоопасной концентрации паров нефтепродуктов в помещениях и трубопроводах судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Пожарная безопасность работ контролируется пожарной охраной ВОХР.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.8. Во время нахождения танкера в ремонте анализ воздуха в танках должен производиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ежедневно сотрудниками заводской лаборатории. Если в грузовых танках будут производиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 огневые и другие работы, то такой анализ должен быть сделан до начала ремонтных работ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.9. Мастера и бригадиры судоремонтных заводов до начала работ на судне с применением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 открытого огня обязаны предварительно поставить об этом в известность капитана судна, в его}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсутствие - вахтенного помощника капитана и пожарную охрану завода.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Вахтенным помощником капитана проверяется разрешение на производство огневых работ и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ведется учет - начало работ, точное место, окончание работ, а также контролируется безопасность}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выполнения работ, для чего необходимо убедиться в том, что:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вблизи места предстоящих огневых работ действительно нет скопления воспламеняющихся или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 токсичных газов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 вблизи места работ нет пропитанной нефтепродуктами ржавчины или другого материала,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 способного выделять опасный газ;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 поблизости или в соседних помещениях нет материалов, которые могут воспламениться;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 соответствующий огнегасительный инвентарь, включая огнетушители, поднесен к месту}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 предстоящих работ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.10. Разрешение на производство огневых и огнеопасных работ, выданное администрацией}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 завода, автоматически теряет силу действия, если:}\par}{\pard \sl-113\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-908\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 произошло изменение характера работ с огнем против указанного в разрешении;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 огневые работы выполняются в иных условиях и на другом рабочем месте.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 В этих случаях разрешение должно быть переоформлено с обязательным осмотром нового места}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 работы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.11. При содержании паров углеводородов в воздушной среде грузовых танков больше}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 санитарной нормы (300 мг/куб. м: 0,02% объемных) нахождение в них рабочих, не защищенных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изолирующими противогазами, и производство работ запрещаются (см. Приложение 2).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.12. Старший механик осуществляет контроль за подготовкой и безопасным проведением}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ремонтных работ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.13. При производстве в недегазированном танке ремонта клинкета, трубопровода, змеевика}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 системы подогрева груза и др. необходимо подготовить соответствующую переносную емкость,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чтобы предотвратить разлив оставшихся в них нефтепродуктов на днище танка и образование}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 опасной загазованности танка.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.14. Ремонтные работы без применения открытого огня на судах, перевозящих летучие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродукты и недегазированных, могут быть допущены по специальному разрешению капитана}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна при полной гарантии безопасности. Указанные работы запрещается проводить в районе}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовой палубы и в пожароопасных помещениях.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.15. Проведение газосварочных работ в машинно-котельном отделении разрешается при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 выполнении п. п. 2.35 - 2.38 настоящих Правил.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.16. На танкерах с нелетучими нефтепродуктами на борту допускается проведение ремонтных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 работ вне района грузовых танков, коффердамов и насосных отделений, без применения открытого}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 огня.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 22.17. На танкерах, осуществлявших регулярные перевозки сернистых сортов нефти, при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ремонтных работах следует соблюдать большую осторожность, так как передача тепла через палубу,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борта или переборки при электросварке или газовой резке может быть достаточной, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воспламенить ранее образовавшиеся внутри танка пирофорические отложения.}\par}{\pard \sl-818\par}{\pard \sl-0\tx3480{\tab\f0\cf1\fs24 \b 23. Общие меры по предупреждению пожаров}\par}{\pard \sl-308\par}{\pard \sl-0\tx5115{\tab\f0\cf1\fs24 \b и борьба с ними}\par}{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.1. Организация всех профилактических противопожарных мероприятий на судне должна}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быть поставлена так, чтобы исключить возможность возникновения пожаров.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2. К таким профилактическим мероприятиям относятся:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2.1. Строгое соблюдение противопожарного режима и мер пожарной безопасности,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обусловленных в настоящих Правилах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2.2. Выполнение в установленные сроки всех противопожарных мероприятий, предлагаемых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожарным надзором.}\par}{\pard \sl-413\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2.3. Проведение максимума огневых работ на берегу путем снятия с судна деталей, узлов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 участков трубопроводов и т.п., подлежащих сварке или резке.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2.4. Содержание в хорошем техническом состоянии всех механизмов, систем и устройств,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 обеспечивающих безопасную работу танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2.5. Систематическое обучение и тренировка личного состава правилам и способам}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 применения противопожарных систем и устройств, имеющихся на судне, проведение учебных}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожарных тревог по тушению условных пожаров в различных условиях плавания (Приложение 10).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2.6. Удаление с судна излишнего количества горючих материалов, хранящихся в кладовых и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подсобных помещениях судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.2.7. Хранение легковоспламеняющихся жидкостей, растворителей и красок в отдельных,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 специально оборудованных помещениях судна.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.3. На каждом судне должно быть вывешено на видных местах общесудовое расписание по}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тревогам, а индивидуальные расписания и перечень обязанностей отдельных членов экипажа по}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тревогам должны быть вывешены над койкой каждого члена экипажа. При стоянке в порту, на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 заводе, у борта другого судна должно быть разработано и вывешено стояночное расписание по}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борьбе с пожарами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.4. Учебные общесудовые тревоги по тушению пожара на судне должны проводиться не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 менее раза в месяц, при этом необходимо добиться четкого и правильного выполнения каждым}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 членом экипажа своих обязанностей по расписанию.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 По окончании учебных тревог необходимо проводить разбор учения с участием комсостава}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна. О проведенных тревогах делается запись в судовом журнале и пожарно-контрольном}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 формуляре.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.5. Немедленные и решительные действия личного состава в момент возникновения пожара и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 умелое использование всех противопожарных средств являются основными мероприятиями при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 борьбе с огнем, а твердое знание и четкое выполнение настоящих Правил и Наставления по борьбе за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 живучесть судов морского флота Союза ССР (РД 31.60.14-81) каждым членом экипажа и контроль за}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 соблюдением их всеми находящимися на судне лицами - лучшими мерами предупреждения пожара.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.6. На исправное состояние имеющихся на нефтеналивных судах средств пожаротушения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 (углекислотное, СЖБ, паротушение, пенотушение, водотушение) надлежит обращать особое}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 внимание, хорошо изучать и знать правила быстрого приведения их в действие.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.7. При использовании систем углекислотного и пенного пожаротушения необходимо строго}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 руководствоваться имеющимися инструкциями. Одновременный пуск в помещение пара и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 углекислоты не допускается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 При применении пены средней кратности необходимо руководствоваться Временной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 инструкцией (Приложение 9).}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.8. Паротушение, углекислоту и СЖБ следует применять только после выхода всех людей и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 герметизации помещения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.9. При постановке судна на большой ремонт необходимо из систем пенотушения слить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 компоненты, промыть емкости и трубопроводы, проверить состояние арматуры и снова зарядить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 емкости качественной пламегасящей жидкостью и пенообразователем.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.10. При тушении или локализации пожара следует широко применять водораспылители. При}\par}{\pard \sl-233\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подаче пены в очаг огня воду подавать запрещается.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.11. При тушении пожаров в задымленных помещениях должны применяться изолирующие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 противогазы, работающие на сжатом воздухе АСВ-2 (Приказ ММФ N 174 от 11.11.82), вместо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 использовавшихся ранее кислородных изолирующих противогазов КИП.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.12. К работе в АСВ-2 допускаются лица, прошедшие медосмотр и усвоившие правила}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пользования ими (Приложение 11). Каждый противогаз должен быть закреплен за определенным}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 лицом. Лицо, отвечающее за хранение и содержание АСВ-2 в рабочем состоянии, назначается}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 приказом капитана.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.13. Рабочее давление сжатого воздуха в баллонах АСВ-2 перед входом в задымленные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помещения не должно быть меньше того, которое указано в Инструкции.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.14. Виды и сроки проверки АСВ-2 определяются Инструкцией. На судне должно быть}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 организовано систематическое изучение устройства АСВ-2 и обучение работе в них по специальной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 программе (см. Приложение 11), для чего на судне должны быть три учебных АСВ-2.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.15. Изолирующие противогазы следует хранить в специальном сухом помещении (на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 стеллажах, обитых амортизационным материалом - резиной, войлоком и др.), расположенном в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 надстройке судна и имеющем отдельный вход с палубы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.16. Член экипажа, обнаруживший пожар или его признаки, должен через ближайший}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 извещатель или любым другим способом сообщить об этом вахтенной службе и принять все меры к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 его локализации и тушению подручными средствами до прихода аварийной партии.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.17. Вахтенный помощник капитана обязан немедленно по общесудовой трансляции уточнить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 место пожара и дать указание экипажу действовать в соответствии с оперативным планом по борьбе}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 с пожаром, доложить капитану о случившемся и предпринятых действиях.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.18. При пожарной тревоге немедленно прекращаются все грузовые и бункеровочные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 операции, а также мойка танков и дегазация, если они проводились, перекрываются клинкеты}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовой магистрали и проводится герметизация грузовых и бункерных танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.19. Если пожар начался при стоянке танкера в порту, необходимо немедленно вызвать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 береговую пожарную команду.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.20. Если пожар начался при следовании в открытом море, необходимо лечь на такой курс,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чтобы искры из очага пожара не попадали на грузовую палубу.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.21. Обо всех случаях загораний и пожаров на судне независимо от их размеров надлежит}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 немедленно сообщить начальнику пароходства и в отряд ВОХР.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.22. Тушение пожара прежде всего начинают на решающем направлении. Решающим}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 направлением считается то, на котором наиболее интенсивно распространяется огонь и пламя}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 угрожает людям или каким-либо важным объектам, особенно грузовым танкам с нефтепродуктами.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.23. Чтобы ограничить распространение пожара на другие объекты, необходимо привести в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 действие систему орошения и начать интенсивное охлаждение струями воды соседних с пожаром}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 участков палуб, переборок, надстроек, конструкций, а также удаление из соседних помещений}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 горючих материалов, инвентаря, груза, оборудования.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.24. Для лучшей организации тушения пожара и предотвращения его распространения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо все время с момента возникновения пожара и до его ликвидации вести тщательную}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 разведку.}\par}{\pard \sl-233\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-788\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.25. Группа разведки должна быть обеспечена необходимой одеждой, изолирующими}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 дыхательными аппаратами, взрывозащищенными фонарями, страхующими негорючими концами,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 портативными взрывозащищенными радиопередатчиками.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.26. Пожары на нефтеналивных судах подразделяются на следующие виды:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 факельное горение паров нефтепродуктов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 загорание нефтепродуктов, разлитых на палубе;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 горение нефтепродуктов на поверхности воды;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 пожары и взрывы внутри танков;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 пожары в насосном отделении;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 загорание тарных нефтепродуктов;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 загорание электрического оборудования;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 пожар в машинно-котельном отделении;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 пожар в каютах и служебных помещениях;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 пожар вблизи танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27. Факельное горение паров нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.1. Факельное горение выходящих из грузовых танков паров нефтепродуктов может}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 произойти над смотровым лючком, на выходе газоотводной системы, над открытой замерной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 трубкой или над другим отверстием в грузовом танке.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.2. Загорание выходящих из танков паров нефтепродуктов может произойти от:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 искры из дымовой трубы самого танкера;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 искры из дымовой трубы другого судна;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 грозового разряда;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 разряда статического электричества;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 искры, возникшей при ударе металла о металл.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.3. Наружное факельное горение возможно, если концентрация паров нефтепродуктов в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танках превышает верхний предел взрываемости.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.4. Успех тушения факельного горения зависит главным образом от быстроты действий}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 членов экипажа, так как вместо сгорающих насыщенных паров нефтепродуктов в танк поступает}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 наружный воздух, разбавляющий и приближающий их к опасной взрывной концентрации. Если}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отверстие танка не закрыто пламепрерывающей сеткой, факельное горение может закончиться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 взрывом в танке.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.5. Если во время загрузки танкера или приема балласта в недегазированный танк}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загорелись выходящие пары нефтепродуктов над смотровым лючком или на выходе газоотводной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 системы, необходимо немедленно прекратить погрузку или прием балласта. Выход паров из танка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прекращается, и факел обычно гаснет.}\par}{\pard \sl-308\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.6. Если факел продолжает гореть после остановки погрузки, необходимо попытаться}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 отсечь его, закрыв крышку лючка. Если из-под крышки вырывается газ и продолжается горение,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 необходимо на лючок набросить кошму, смоченный брезент или маты. Для уменьшения давления}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 паров в танках палубу охлаждают окатыванием забортной водой, языки пламени пытаются сбить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 струей пены из огнетушителей или водяной струей. Одновременно приводят в действие систему}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 углекислотного тушения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.7. Для того чтобы потушить горящий факел над выходным отверстием газоотводной}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 системы, необходимо быстро перекрыть клапан газоотводной системы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.27.8. Факельное горение паров нефтепродуктов может появиться в результате повреждения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 палубы или борта танкера. Горящий факел необходимо тушить путем отсечения пламени пенной или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 водяной струей и наложением на пробоину кошмы, смоченного брезента или матов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.28. Загорание нефтепродуктов, разлитых на палубе.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.28.1. При загорании нефтепродуктов, разлитых на палубе вследствие перелива груза, разрыва}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузового шланга или утечки из трубопровода, следует немедленно остановить грузовые операции и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 закрыть все клинкеты, включая приемные клинкеты на судне и на берегу, чтобы прекратить доступ}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов на палубу.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.28.2. Для предупреждения попадания огня в грузовые танки необходимо закрыть все}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 смотровые лючки, замерные трубки и другие отверстия грузовых танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.28.3. Для тушения горящих на палубе нефтепродуктов необходимо применять огнетушители,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пену, распыленную воду.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.28.4. Для предупреждения распространения огня по судну необходимо интенсивно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 охлаждать палубу, надстройки, переборки.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29. Горение нефтепродуктов на поверхности воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.1. Если загорелись нефтепродукты на акватории порта, то все танкеры должны прекратить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 грузовые операции, разъединить грузовые шланги и приготовить суда к выходу из нефтегавани.}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 Порядок оставления судами порта устанавливает его администрация.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.2. Если плавающие на воде нефтепродукты загорелись у борта танкера, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 немедленно прекратить грузовые операции, герметизировать все грузовые танки и другие судовые}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помещения, закрыть все клинкеты, разъединить грузовые шланги.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.3. Необходимо интенсивно охлаждать борта судна, грузовую палубу и надстройки,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 включив систему орошения и используя пожарные шланги.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.4. Одновременно необходимо применить для тушения горящих на воде нефтепродуктов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пену и струи воды из пожарных шлангов. Грузовую палубу также необходимо покрыть пеной против}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 возможного попадания на нее горящих частиц и искр.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.5. Для отгона горящих нефтепродуктов от борта танкера необходимо использовать струи}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воды пожарных стволов и струю работающего гребного винта.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.6. Танкеру необходимо как можно быстрее выйти из района горящих на воде}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, чтобы избежать возникновения пожара на борту.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.7. Если при следовании танкера в море из его поврежденного корпуса вытекают в море}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 горящие нефтепродукты, необходимо лечь на такой курс, чтобы горящие нефтепродукты находились с}\par}{\pard \sl-323\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 подветренной стороны.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.29.8. Если с горящего танкера, вокруг которого плавает горящая нефть, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 эвакуировать людей, необходимо главному двигателю на короткое время дать задний ход. В этом}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 случае струей воды от работающего гребного винта горящие на воде нефтепродукты будут отнесены к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 носовой части судна, а у кормы будет чистая вода, где можно произвести высадку людей.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30. Пожары и взрывы внутри танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.1. Лучшее профилактическое средство для предупреждения пожаров внутри грузовых}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков - заполнение их инертным газом на всех стадиях работы танкера: перевозках нефтепродуктов,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 балластировках и мойках танков.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.2. Если грузовое пространство груженого танка заполнено насыщенными парами,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 концентрация которых выше верхнего предела взрываемости, то пожар обычно начинается}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 факельным горением, и, если его не удастся быстро потушить, обедненные в результате горения пары}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов, находящиеся в танке, взрываются, производя разрушения в конструкциях танкера и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воспламеняя нефтепродукты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.3. При пожаре в грузовом танке сила взрыва зависит от сорта нефтепродуктов и от}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 величины газового пространства: чем оно больше, тем сильнее бывает взрыв.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.4. При возникновении пожара в грузовом танке или топливном отсеке необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 немедленно заполнить его и прилегающие к нему помещения углекислотой, инертным газом, паром.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.5. Одновременно необходимо осуществлять интенсивное охлаждение водой}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 примыкающих площадей: палубы, бортов, переборок, надстроек.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.6. Если силой взрыва сорвана палуба над горящим танком, необходимо организовать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пенную атаку. Струю пены необходимо направлять на вертикальную поверхность переборки танка}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вблизи очага огня так, чтобы, стекая, она покрывала равномерным слоем всю поверхность горящих}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.7. Надо избегать перемешивания пены, чтобы не нарушить ее сплошной слой на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поверхности нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.8. Для тушения горящих в танке непродолжительное время нефтепродуктов можно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 применить распыленную воду, направленную на всю площадь огня.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Нефтепродукты, горящие долгое время, нельзя потушить водяными струями, так как они}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 успевают прогреться на большую глубину и не могут быть быстро охлаждены до температуры, при}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 которой прекращается парообразование горящих нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.9. Одновременное применение пены и распыленной воды недопустимо.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.10. Пожар в грузовом танке может сопровождаться следующими явлениями:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 переносом раскаленных частиц потоками воздуха к другим горючим веществам и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 воспламенением их;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 передачей тепловой энергии через раскаленный металл от горящего танка к смежным;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 выбросами и переливами горящих нефтепродуктов из танка на палубу и другие части судна;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 растеканием горящих нефтепродуктов по поверхности воды вследствие повреждения корпуса}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судна.}\par}{\pard \sl-203\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-818\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.11. После ликвидации пожара в грузовом танке подачу пены и их охлаждение не следует}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 прекращать сразу. Необходимо тщательно проверить, не остались ли не покрытыми пеной отдельные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 участки нефтепродуктов и нет ли искр на внутренней стороне переборок в местах налета сажи, что}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 может привести к повторному загоранию.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.30.12. После окончания тушения пожара в этом месте выставляют вахтенных с}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 противопожарными средствами, подготовленными к немедленному действию в случае повторного}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 загорания.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.31. Пожары в насосном отделении.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.31.1. Пожар в насосном отделении чаще всего происходит при следующих обстоятельствах:}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 утечке нефтепродуктов в льяла насосного отделения;}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 недостаточной вентиляции насосного отделения для поддержания скапливающихся паров}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 нефтепродуктов ниже нижнего предела взрываемости (загорания);}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 неисправностях оборудования, приводящих к чрезмерному перегреву отдельных деталей,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 достаточному для воспламенения нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.31.2. Если загорание не распространяется дальше насоса или другого агрегата, его можно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 быстро потушить, применив огнетушители.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.31.3. Если возникший в насосном отделении пожар невозможно потушить при помощи}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 огнетушителей, необходимо применить объемное тушение, для чего предварительно произвести}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 полную герметизацию, задраив все двери, световые люки и вентиляционные трубы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.31.4. Одновременно с подачей огнегасящего агента в насосное отделение следует подать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 средства пожаротушения в смежные отсеки или заполнить их паром, а также охлаждать прилегающие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поверхности струями воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.32. Загорание тарных нефтепродуктов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.32.1. Если нефтепродукты в таре загорелись на палубе, для их тушения необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 применить огнетушители и пену.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.32.2. Для тушения нефтепродуктов в таре, находящихся в сухогрузном трюме, необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 применить объемное тушение: углекислоту, пар и др.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.32.3. Одновременно необходимо установить наблюдение за температурой переборок и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 палубы и охлаждать их струями воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.32.4. Если пожар в трюме не может быть потушен, необходимо затопить его водой.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.32.5. Если на поверхности воды в затопленном трюме будут плавать горящие нефтепродукты,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 их необходимо тушить при помощи пены или распыленной воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.32.6. Во время затопления трюма необходимо следить за тем, чтобы плавающие на}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 поверхности горящие или негорящие нефтепродукты не переливались через комингс трюма в другие}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 судовые помещения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.33. Загорание электрического оборудования.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.33.1. Загорание электрического оборудования может быть вызвано коротким замыканием,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 неплотным контактом, перегрузкой, перегревом либо распространением огня от горящих твердых}\par}{\pard \sl-218\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 или жидких материалов.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.33.2. При загорании должно быть немедленно отключено питание от загоревшихся агрегатов}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 и приборов. После этого применяется один из доступных способов тушения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.33.3. Если электроцепь не может быть обесточена, для тушения пожара надлежит применять}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 неэлектропроводное средство: СБЖ или углекислый газ.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.33.4. Нельзя использовать водяную струю или распыленную воду и воздушно-механическую}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пену из-за опасности поражения электрическим током и новых замыканий в электроцепи.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34. Пожар в машинно-котельном отделении.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34.1. При возникновении пожара в машинно-котельном отделении для тушения необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 применять: химические углекислотные огнетушители, кошму и, в зависимости от обстановки и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 размера пожара, пену или распыленную воду.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34.2. Если переносными огнегасительными средствами или пеной не удается ликвидировать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожар, необходимо применить объемное тушение.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34.3. К моменту включения системы объемного тушения должна быть произведена}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 герметизация помещения, все люди эвакуированы, а с палубы перекрыто поступление топлива к}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 машине.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34.4. После этого следует вести наблюдение за переборками и температурой в соседних}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 помещениях, производить охлаждение переборок и палубы и применять все меры, чтобы}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 изолировать очаг пожара от дальнейшего распространения по судну.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34.5. Понижение температуры переборок, бортов и палубы является признаком прекращения}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожара. Снижение температуры показывает, что прекратилось интенсивное горение, но тление}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 может еще продолжаться, поэтому помещение надо держать некоторое время загерметизированным,}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 чтобы приток свежего воздуха не вызвал повторное воспламенение.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34.6. Перед вскрытием помещения, в котором пожар был ликвидирован с помощью}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 объемных средств, должны быть приготовлены к действию переносные пожарные средства, чтобы в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 случае необходимости потушить тлеющие материалы.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.34.7. Пока помещение полностью не провентилировано от углекислотных газов, паров}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 гасящей жидкости и дыма, в нем можно находиться только в изолирующих дыхательных аппаратах.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35. Пожар в каютах и служебных помещениях.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35.1. При пожаре в каюте или служебном помещении необходимо выключить искусственную}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 вентиляцию и систему кондиционирования воздуха, закрыть заслонки в вентиляционных каналах}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 всех помещений для предотвращения распространения огня в другие помещения. Отключить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 электропитание.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35.2. Для тушения обнаруженного пожара необходимо как можно быстрее использовать}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 ближайшие огнетушители. Если огнетушители не дали нужного эффекта, нужно применить воду или}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пену. Пенотушение является наиболее эффективным средством при тушении пожаров.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35.3. Необходимо принять все меры, чтобы пламя из горящей каюты не вырывалось в}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 коридор, так как сквозняком его легко может перебросить в другие помещения.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35.4. При пожаре в помещении сильное задымление может вызвать образование окиси}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 углерода, поэтому при его тушении необходимо заблаговременно поднести к месту пожара и держать}\par}{\pard \sl-113\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
{{\pard \sl-743\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 наготове изолирующие дыхательные аппараты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35.5. При обнаружении большого пламени до вооружения пожарных стволов необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 плотно закрыть двери горящей каюты, чтобы пламя не распространилось на другие помещения. Для}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 тушения пожара лучше выбить нижнюю филенку двери и через образовавшееся отверстие тушить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 пожар из пенного или водяного ствола. При этом переборки смежных помещений необходимо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 постоянно охлаждать.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35.6. Для тушения огня в помещении более эффективно применение распыленной воды.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Если необходимо потушить огонь в дальнем углу помещения, используют сплошную водяную}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 струю.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.35.7. После того как пожар в помещении был потушен, необходимо вести постоянное}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 наблюдение на случай повторного загорания, имея наготове все необходимые противопожарные}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 средства.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 Горевшие предметы должны быть обильно смочены, так чтобы все слои были хорошо}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 увлажнены.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.36. Пожар вблизи танкера.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.36.1. Если пожар возник на берегу или на борту другого судна, необходимо объявить}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 общесудовую тревогу и приготовить к действию все противопожарные средства.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.36.2. В этом случае грузовые, балластные, бункерные, дегазационные и работы по мойке}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 танков должны быть прекращены и все горловины и отверстия танков, световые люки насосного и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 машинного отделений, иллюминаторы и наружные двери судовых помещений закрыты.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.36.3. Судовые и береговые приемные клинкеты должны быть закрыты, а грузовые и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 бункерные шланги отданы. Главная машина должна быть готова к немедленному действию.}\par}{\pard \sl-233\par}{\pard \sl-0\tx1275{\tab\f0\cf1\fs24 23.36.4. Если танкер стоит с подветренной стороны от судна, на котором возник пожар, и не}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 может покинуть своего места, необходимо включить систему орошения и обливать переборки и}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 надстройки из пожарных шлангов, чтобы предупредить возникновение пожара от случайно}\par}{\pard \sl-0\tx735{\tab\f0\cf1\fs24 залетевших искр.}\par}{\pard \sl-3293\par}{\pard \sl-0\tx9720{\tab\f0\cf1\fs24 Приложение 1}\par}{\pard \sl-233\par}{\pard \sl-0\tx9645{\tab\f0\cf1\fs24 Рекомендуемое}\par}{\pard \sl-818\par}{\pard \sl-0\tx3180{\tab\f0\cf1\fs24 \b СПОСОБЫ КОНТРОЛЯ ВЗРЫВОБЕЗОПАСНОГО}\par}{\pard \sl-398\par}{\pard \sl-0\tx930{\tab\f0\cf1\fs24\adjustright Не является официальной версией, бесплатно предоставляется членам Ассоциации лесопользователей\tab Приладожья, Поморья и Прионежья – } {\field{\*\fldinst HYPERLINK "http://www.alppp.ru/"}{\fldrslt \f0\cf2\fs24 \ul www.alppp.ru.}}{\tab\f0\cf1\fs24\adjustright Постоянно действующий третейский суд.}\par }}\sect \sectd\pgwsxn11905\pghsxn16838\marglsxn0\margrsxn0\margtsxn0\margbsxn0\headery0\footery0\sectdefaultcl\pgbrdrhead\pgbrdrfoot
